                    <!-- Check grande -->
                    <polyline
                        points="24,38 30,44 42,30"
                        stroke="#C01010"
                        stroke-width="2"
                        fill="none"
                        stroke-linecap="round"
                        stroke-linejoin="round"></polyline>
                </svg>
            </div>
            <span class="cert-badge">Gestión</span>
            <h3 class="cert-name">PMP</h3>
            <p class="cert-full">Project Management Professional</p>
            <p class="cert-desc">
                Certificación del Project Management Institute que acredita
                competencias avanzadas en la gestión de proyectos complejos:
                planificación, control de riesgos, presupuesto y liderazgo de
                equipos multidisciplinarios.
            </p>
            <ul class="cert-features">
                <li>Planificación y control de cronogramas</li>
                <li>Gestión de riesgos y cambios</li>
                <li>Control presupuestal avanzado</li>
                <li>Liderazgo de equipos de obra</li>
            </ul>
        </div>
    </div>

    <!-- Strip de datos -->
    <div class="cert-strip fade-up">
        <div class="cert-strip-item">
            <span class="cert-strip-num">3</span>
            <span class="cert-strip-text"
                >Certificaciones<br />internacionales activas</span
            >
        </div>
        <div class="cert-strip-item">
            <span class="cert-strip-num">100%</span>
            <span class="cert-strip-text"
                >Proyectos con metodología<br />BIM desde 2018</span
            >
        </div>
        <div class="cert-strip-item">
            <span class="cert-strip-num">+15</span>
            <span class="cert-strip-text"
                >Profesionistas certificados<br />en nuestro equipo</span
            >
        </div>
    </div>
</section>
