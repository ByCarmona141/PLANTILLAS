---
import logo from "../assets/logo.svg";
---

<style is:inline>
    /* ── NAV ── */
    #nav {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 500;
        display: flex;
        flex-direction: column;
        transition: transform 0.4s ease;
    }

    /* Top strip */
    .nav-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 3rem;
        height: 36px;
        background: var(--red);
        transition:
            height 0.4s ease,
            opacity 0.4s ease;
        overflow: hidden;
    }
    #nav.solid .nav-top {
        height: 0;
        opacity: 0;
        pointer-events: none;
    }
    .nav-top-left {
        display: flex;
        align-items: center;
        gap: 2rem;
    }
    .nav-top-item {
        font-size: 0.58rem;
        font-weight: 300;
        letter-spacing: 0.2em;
        color: rgba(245, 242, 238, 0.75);
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
    .nav-top-item svg {
        width: 10px;
        height: 10px;
        opacity: 0.7;
    }
    .nav-top-right {
        font-size: 0.58rem;
        font-weight: 300;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: rgba(245, 242, 238, 0.6);
    }

    /* Main bar */
    .nav-main {
        display: flex;
        flex-direction: row;
        align-items: stretch;
        height: 60px;
        background: rgba(8, 8, 8, 0.96);
        backdrop-filter: blur(16px);
        border-bottom: 1px solid rgba(245, 242, 238, 0.07);
        transition: border-color 0.4s;
        position: relative;
    }
    #nav.solid .nav-main {
        border-color: rgba(140, 10, 10, 0.25);
    }

    /* Logo block */
    .nav-logo-block {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 0 2.5rem 0 3rem;
        text-decoration: none;
        border-right: 1px solid rgba(245, 242, 238, 0.07);
        transition: border-color 0.4s;
    }
    #nav.solid .nav-logo-block {
        border-color: rgba(140, 10, 10, 0.2);
    }
    .nav-logo-block svg {
        height: 50px;
        width: auto;
        flex-shrink: 0;
    }
    .nav-logo-block svg path {
        fill: #f5f2ee;
    }
    .nav-logo-text {
        display: flex;
        flex-direction: column;
        gap: 1px;
    }
    .nav-logo-name {
        font-family: var(--display);
        font-size: 1.2rem;
        letter-spacing: 0.28em;
        color: var(--white);
        line-height: 1;
    }
    .nav-logo-tagline {
        font-size: 0.48rem;
        font-weight: 200;
        letter-spacing: 0.3em;
        text-transform: uppercase;
        color: rgba(245, 242, 238, 0.3);
    }

    /* Links center */
    .nav-links-center {
        flex: 1;
        display: flex;
        flex-direction: row;
        align-items: stretch;
        justify-content: center;
        overflow: hidden;
    }
    .nav-links-center a {
        display: flex;
        align-items: center;
        font-size: 0.62rem;
        font-weight: 300;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: rgba(245, 242, 238, 0.45);
        text-decoration: none;
        padding: 0 1.4rem;
        position: relative;
        transition: color 0.3s;
        border-right: 1px solid rgba(245, 242, 238, 0.05);
    }
    .nav-links-center a:first-child {
        border-left: 1px solid rgba(245, 242, 238, 0.05);
    }
    .nav-links-center a::after {
        content: "";
        position: absolute;
        bottom: 0;
        left: 50%;
        transform: translateX(-50%);
        width: 0;
        height: 2px;
        background: var(--red);
        transition: width 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .nav-links-center a:hover {
        color: var(--white);
    }
    .nav-links-center a:hover::after {
        width: 100%;
    }
    .nav-links-center a.active {
        color: var(--white);
    }
    .nav-links-center a.active::after {
        width: 100%;
        background: var(--red);
    }

    /* Drawer active */
    .drawer-links a.active {
        color: var(--white);
        padding-left: 2rem;
        background: rgba(140, 10, 10, 0.1);
    }
    .drawer-links a.active::after {
        opacity: 1;
        color: var(--red);
    }

    /* Right block */
    .nav-right-block {
        display: flex;
        align-items: stretch;
        flex-shrink: 0;
        border-left: 1px solid rgba(245, 242, 238, 0.07);
        transition: border-color 0.4s;
        margin-left: auto;
    }
    #nav.solid .nav-right-block {
        border-color: rgba(140, 10, 10, 0.2);
    }
    .nav-cta-btn {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        font-size: 0.62rem;
        font-weight: 400;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--white);
        text-decoration: none;
        padding: 0 2rem;
        position: relative;
        overflow: hidden;
        transition: color 0.3s;
    }
    .nav-cta-btn::before {
        content: "";
        position: absolute;
        inset: 0;
        background: var(--red);
        transform: translateX(-101%);
        transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .nav-cta-btn:hover::before {
        transform: translateX(0);
    }
    .nav-cta-btn span,
    .nav-cta-btn svg {
        position: relative;
        z-index: 1;
    }
    .nav-cta-btn svg {
        width: 12px;
        height: 12px;
        opacity: 0.6;
        transition:
            transform 0.3s,
            opacity 0.3s;
    }
    .nav-cta-btn:hover svg {
        transform: translateX(3px);
        opacity: 1;
    }

    /* Hamburger */
    .nav-burger {
        display: none;
        align-items: center;
        justify-content: center;
        width: 58px;
        background: none;
        border: none;
        border-left: 1px solid rgba(245, 242, 238, 0.07);
        cursor: pointer;
        flex-direction: column;
        gap: 5px;
        padding: 0;
        transition: background 0.3s;
    }
    .nav-burger:hover {
        background: rgba(140, 10, 10, 0.15);
    }
    .nav-burger span {
        display: block;
        width: 20px;
        height: 1.5px;
        background: var(--white);
        transition:
            transform 0.35s ease,
            opacity 0.35s ease,
            width 0.35s ease;
    }
    .nav-burger span:nth-child(2) {
        width: 14px;
    }
    .nav-burger.open span:nth-child(1) {
        transform: translateY(6.5px) rotate(45deg);
        width: 20px;
    }
    .nav-burger.open span:nth-child(2) {
        opacity: 0;
        width: 0;
    }
    .nav-burger.open span:nth-child(3) {
        transform: translateY(-6.5px) rotate(-45deg);
        width: 20px;
    }

    /* Progress bar */
    .nav-progress {
        position: absolute;
        bottom: 0;
        left: 0;
        height: 1px;
        background: var(--red);
        width: 0;
        transition: width 0.1s linear;
        pointer-events: none;
    }

    /* Side drawer (mobile) */
    .nav-drawer {
        position: fixed;
        top: 0;
        right: 0;
        bottom: 0;
        width: min(320px, 85vw);
        z-index: 490;
        background: var(--off-black);
        border-left: 1px solid rgba(140, 10, 10, 0.3);
        display: flex;
        flex-direction: column;
        transform: translateX(100%);
        transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
        pointer-events: none;
    }
    .nav-drawer.open {
        transform: translateX(0);
        pointer-events: all;
    }
    .drawer-overlay {
        position: fixed;
        inset: 0;
        z-index: 480;
        background: rgba(8, 8, 8, 0.7);
        backdrop-filter: blur(4px);
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.4s ease;
    }
    .drawer-overlay.open {
        opacity: 1;
        pointer-events: all;
    }
    .drawer-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1.25rem 1.5rem;
        border-bottom: 1px solid rgba(245, 242, 238, 0.07);
    }
    .drawer-logo {
        font-family: var(--display);
        font-size: 1.1rem;
        letter-spacing: 0.25em;
        color: var(--white);
    }
    .drawer-close {
        width: 36px;
        height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: none;
        border: 1px solid rgba(245, 242, 238, 0.12);
        cursor: pointer;
        color: rgba(245, 242, 238, 0.6);
        font-size: 1.1rem;
        transition:
            border-color 0.3s,
            color 0.3s;
    }
    .drawer-close:hover {
        border-color: var(--red);
        color: var(--white);
    }
    .drawer-links {
        flex: 1;
        display: flex;
        flex-direction: column;
        padding: 1.5rem 0;
    }
    .drawer-links a {
        font-size: 0.78rem;
        font-weight: 300;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: rgba(245, 242, 238, 0.45);
        text-decoration: none;
        padding: 1rem 1.5rem;
        border-bottom: 1px solid rgba(245, 242, 238, 0.05);
        display: flex;
        align-items: center;
        justify-content: space-between;
        transition:
            color 0.25s,
            padding-left 0.25s,
            background 0.25s;
    }
    .drawer-links a::after {
        content: "→";
        opacity: 0;
        transition: opacity 0.25s;
        font-size: 0.7rem;
    }
    .drawer-links a:hover {
        color: var(--white);
        padding-left: 2rem;
        background: rgba(140, 10, 10, 0.08);
    }
    .drawer-links a:hover::after {
        opacity: 1;
    }
    .drawer-foot {
        padding: 1.5rem;
        border-top: 1px solid rgba(245, 242, 238, 0.07);
    }
    .drawer-cta {
        display: block;
        text-align: center;
        font-size: 0.65rem;
        font-weight: 400;
        letter-spacing: 0.25em;
        text-transform: uppercase;
        color: var(--white);
        background: var(--red);
        text-decoration: none;
        padding: 1rem;
        transition: background 0.3s;
    }
    .drawer-cta:hover {
        background: var(--red-bright);
    }
    .drawer-info {
        margin-top: 1.25rem;
    }
    .drawer-info p {
        font-size: 0.6rem;
        font-weight: 200;
        letter-spacing: 0.1em;
        color: rgba(245, 242, 238, 0.25);
        margin-bottom: 0.35rem;
    }

    @media (max-width: 1060px) {
        .nav-links-center {
            display: none;
        }
        .nav-cta-btn {
            display: none;
        }
        .nav-burger {
            display: flex;
        }
        .nav-top {
            padding: 0 1.5rem;
        }
        .nav-logo-block {
            padding: 0 1.5rem;
        }
    }
    @media (max-width: 480px) {
        .nav-top-left span:last-child {
            display: none;
        }
    }
</style>

<!-- OVERLAY (mobile) -->
<div class="drawer-overlay" id="drawerOverlay" onclick="closeDrawer()"></div>

<!-- SIDE DRAWER (mobile) -->
<div class="nav-drawer" id="drawer">
    <div class="drawer-head">
        <span class="drawer-logo">MONDRIAL</span>
        <button class="drawer-close" onclick="closeDrawer()" aria-label="Cerrar"
            >✕</button
        >
    </div>
    <div class="drawer-links">
        <a href="#servicios" onclick="closeDrawer()">Servicios</a>
        <a href="#nosotros" onclick="closeDrawer()">Nosotros</a>
        <a href="#certificaciones" onclick="closeDrawer()">Certificaciones</a>
        <!-- <a href="#pritzker" onclick="closeDrawer()">Premios</a> -->
        <a href="#clientes" onclick="closeDrawer()">Clientes</a>
        <a href="#contacto" onclick="closeDrawer()">Contacto</a>
    </div>
    <div class="drawer-foot">
        <a href="#contacto" class="drawer-cta" onclick="closeDrawer()"
