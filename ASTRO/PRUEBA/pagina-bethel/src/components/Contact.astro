<style is:inline>
    /* ── CONTACTO ── */
    #contacto {
        background: var(--black);
    }
    .contacto-top {
        background: var(--red);
        padding: 5rem 3rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 2rem;
        flex-wrap: wrap;
    }
    .contacto-big {
        font-family: var(--display);
        font-size: clamp(2.5rem, 6vw, 5.5rem);
        letter-spacing: 0.04em;
        color: var(--white);
        line-height: 0.95;
    }
    .contacto-big em {
        font-family: var(--italic);
        font-style: italic;
        color: rgba(245, 242, 238, 0.6);
        font-weight: 400;
    }
    .contacto-tagline {
        font-size: 0.85rem;
        font-weight: 200;
        color: rgba(245, 242, 238, 0.6);
        max-width: 300px;
        line-height: 1.8;
    }
    /* Body grid: info left, socials right */
    .contacto-body {
        display: grid;
        grid-template-columns: 1fr 1fr;
        min-height: 420px;
    }
    /* Info side */
    .contacto-info-side {
        padding: 4rem 3rem;
        background: var(--off-black);
        border-right: 1px solid var(--white-ghost);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }
    .info-item {
        margin-bottom: 2.25rem;
    }
    .info-label {
        font-size: 0.58rem;
        font-weight: 300;
        letter-spacing: 0.35em;
        text-transform: uppercase;
        color: var(--red-bright);
        margin-bottom: 0.55rem;
    }
    .info-value {
        font-family: var(--display);
        font-size: 1.15rem;
        letter-spacing: 0.06em;
        color: var(--white);
        line-height: 1.3;
    }
    .info-value a {
        color: inherit;
        text-decoration: none;
        transition: color 0.3s;
    }
    .info-value a:hover {
        color: var(--red-bright);
    }
    /* Social side */
    .contacto-social-side {
        padding: 4rem 3rem;
        background: var(--panel);
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 0;
    }
    .social-section-label {
        font-size: 0.58rem;
        font-weight: 300;
        letter-spacing: 0.35em;
        text-transform: uppercase;
        color: rgba(245, 242, 238, 0.3);
        margin-bottom: 2rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }
    .social-section-label::before {
        content: "";
        width: 16px;
        height: 1px;
        background: var(--red);
        flex-shrink: 0;
    }
    .social-list {
        display: flex;
        flex-direction: column;
        gap: 0;
    }
    .social-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1.1rem 0;
        border-bottom: 1px solid var(--white-ghost);
        text-decoration: none;
        transition:
            padding-left 0.3s,
            background 0.3s;
        position: relative;
        overflow: hidden;
    }
    .social-item:first-child {
        border-top: 1px solid var(--white-ghost);
    }
    .social-item::before {
        content: "";
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: 3px;
        background: var(--red);
        transform: scaleY(0);
        transition: transform 0.3s ease;
        transform-origin: bottom;
    }
    .social-item:hover {
        padding-left: 1rem;
    }
    .social-item:hover::before {
        transform: scaleY(1);
    }
    .social-item:hover .social-name {
        color: var(--white);
    }
    .social-item:hover .social-handle {
        color: rgba(245, 242, 238, 0.5);
    }
    .social-item:hover .social-arrow {
        opacity: 1;
        transform: translateX(4px);
        color: var(--red-bright);
    }
    .social-left {
        display: flex;
        align-items: center;
        gap: 1rem;
    }
    .social-icon {
        width: 36px;
        height: 36px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid var(--white-ghost);
        transition:
            border-color 0.3s,
            background 0.3s;
    }
    .social-item:hover .social-icon {
        border-color: rgba(140, 10, 10, 0.5);
        background: rgba(140, 10, 10, 0.12);
    }
    .social-icon svg {
        width: 16px;
        height: 16px;
    }
    .social-name {
        font-size: 0.82rem;
        font-weight: 300;
        color: rgba(245, 242, 238, 0.7);
        letter-spacing: 0.06em;
        transition: color 0.3s;
    }
    .social-handle {
        font-size: 0.65rem;
        font-weight: 200;
        color: rgba(245, 242, 238, 0.25);
        margin-top: 0.1rem;
        letter-spacing: 0.05em;
        transition: color 0.3s;
    }
    .social-arrow {
        font-size: 0.75rem;
        color: rgba(245, 242, 238, 0.2);
        opacity: 0;
        transition:
            opacity 0.3s,
            transform 0.3s,
            color 0.3s;
    }
    @media (max-width: 900px) {
        .contacto-body {
            grid-template-columns: 1fr;
        }
        .contacto-info-side {
            border-right: none;
            border-bottom: 1px solid var(--white-ghost);
        }
        .contacto-info-side,
        .contacto-social-side {
            padding: 3rem 1.5rem;
        }
        .contacto-top {
            padding: 4rem 1.5rem;
        }
    }
</style>

