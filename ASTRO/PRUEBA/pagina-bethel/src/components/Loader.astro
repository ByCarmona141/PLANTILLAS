<style is:inline>
    /* ── LOADER ── */
    #loader {
        position: fixed;
        inset: 0;
        background: var(--black);
        z-index: 10000;
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 1;
        transition: opacity 0.7s ease;
    }
    .loader-inner {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0;
    }
    /* Logo SVG — entra con fade+scale */
    .loader-logo {
        opacity: 0;
        transform: scale(0.8);
        animation: loaderLogoIn 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.2s forwards;
        width: clamp(80px, 20vw, 140px);
        height: auto;
    }
    .loader-logo path {
        fill: #f5f2ee;
    }
    @keyframes loaderLogoIn {
        to {
            opacity: 1;
            transform: scale(1);
        }
    }
    /* Línea roja que aparece debajo del logo antes de las letras */
    .loader-divider {
        width: 0;
        height: 1px;
        background: var(--red);
        margin: clamp(1rem, 3vw, 1.75rem) 0 0;
        animation: loaderDivIn 0.5s ease 2s forwards;
    }
    @keyframes loaderDivIn {
        to {
            width: clamp(60px, 15vw, 100px);
        }
    }
    /* Letras: aparecen letra a letra desde abajo, 2s de delay */
    .loader-word {
        overflow: hidden;
        height: 0;
        animation: loaderWordShow 0s 2.1s forwards;
        margin-top: clamp(0.75rem, 2vw, 1.25rem);
    }
    @keyframes loaderWordShow {
        to {
            height: auto;
        }
    }
    .loader-word span {
        font-family: var(--display);
        font-size: clamp(1.8rem, 7vw, 4rem);
        letter-spacing: clamp(0.25em, 1vw, 0.45em);
        color: var(--white);
        display: inline-block;
        opacity: 0;
        transform: translateY(100%);
        animation: loaderLetterUp 0.55s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    .loader-word span:nth-child(1) {
        animation-delay: 2.15s;
    }
    .loader-word span:nth-child(2) {
        animation-delay: 2.22s;
    }
    .loader-word span:nth-child(3) {
        animation-delay: 2.29s;
    }
    .loader-word span:nth-child(4) {
        animation-delay: 2.36s;
    }
    .loader-word span:nth-child(5) {
        animation-delay: 2.43s;
    }
    .loader-word span:nth-child(6) {
        animation-delay: 2.5s;
    }
    .loader-word span:nth-child(7) {
        animation-delay: 2.57s;
    }
    @keyframes loaderLetterUp {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<div id="loader">
