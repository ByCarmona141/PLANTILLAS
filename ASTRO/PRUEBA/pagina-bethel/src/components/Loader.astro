        <div class="loader-divider"></div>

        <!-- Letras con delay de 2s -->
        <div class="loader-word">
            <span>M</span><span>O</span><span>N</span><span>D</span><span
                >R</span
            ><span>I</span><span>A</span><span>L</span>
        </div>
    </div>
</div>

<script>
    // Loader
    window.addEventListener("load", () => {
        setTimeout(() => {
            const l = document.getElementById("loader");
            l.style.opacity = "0";
            setTimeout(() => (l.style.display = "none"), 700);
        }, 3400);
    });
</script>
