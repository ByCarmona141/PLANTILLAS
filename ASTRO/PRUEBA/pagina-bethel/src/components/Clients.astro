<style is:inline>
    /* ── CLIENTES ── */
    #clientes {
        padding: 7rem 3rem;
        background: var(--black-soft);
    }
    .clientes-top {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        margin-bottom: 4.5rem;
        gap: 2rem;
        flex-wrap: wrap;
    }
    .clientes-heading {
        font-family: var(--display);
        font-size: clamp(2.5rem, 5vw, 4.5rem);
        letter-spacing: 0.04em;
        color: var(--white);
        line-height: 0.95;
    }
    .clientes-heading em {
        font-family: var(--italic);
        font-style: italic;
        font-size: 0.85em;
        color: rgba(245, 242, 238, 0.45);
        font-weight: 400;
    }
    .clientes-count {
        font-size: 0.72rem;
        font-weight: 300;
        letter-spacing: 0.15em;
        color: var(--white-dim);
        border-top: 1px solid var(--white-ghost);
        padding-top: 1rem;
    }
    .clients-list {
        display: flex;
        flex-direction: column;
        gap: 0;
    }
    .client-row {
        display: grid;
        grid-template-columns: 48px 1fr auto;
        align-items: center;
        gap: 2rem;
        padding: 1.5rem 0;
        border-bottom: 1px solid var(--white-ghost);
        transition: background 0.3s;
        cursor: default;
    }
    .client-row:hover {
        background: rgba(140, 10, 10, 0.06);
    }
    .client-index {
        font-family: var(--display);
        font-size: 0.85rem;
        color: rgba(245, 242, 238, 0.18);
        letter-spacing: 0.1em;
    }
    .client-info {
    }
    .client-n {
        font-size: 0.95rem;
        font-weight: 300;
        color: var(--white);
        letter-spacing: 0.04em;
    }
    .client-s {
        font-size: 0.7rem;
        font-weight: 200;
        color: var(--white-dim);
        margin-top: 0.15rem;
    }
    .client-pill {
        font-size: 0.58rem;
        font-weight: 300;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: rgba(245, 242, 238, 0.3);
        border: 1px solid var(--white-ghost);
        padding: 0.3rem 0.9rem;
    }
    /* ── TESTIMONIAL CAROUSEL ── */
    .testi-carousel {
        margin-top: 5rem;
        border: 1px solid var(--white-ghost);
        position: relative;
        overflow: hidden;
    }
    .testi-track {
        display: flex;
        transition: transform 0.65s cubic-bezier(0.16, 1, 0.3, 1);
        will-change: transform;
    }
    .testi-slide {
        min-width: 100%;
        display: grid;
        grid-template-columns: 1fr 1fr;
    }
    .testi-left {
        padding: 4rem;
        background: var(--red-pale);
        border-right: 1px solid rgba(140, 10, 10, 0.3);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }
    .testi-q {
        font-family: var(--display);
        font-size: 7rem;
        color: rgba(192, 16, 16, 0.28);
        line-height: 0.65;
        margin-bottom: 1.75rem;
    }
    .testi-text {
        font-family: var(--italic);
        font-size: 1.1rem;
        font-style: italic;
        font-weight: 400;
        color: rgba(245, 242, 238, 0.78);
        line-height: 1.9;
        flex: 1;
    }
    .testi-stars {
        display: flex;
        gap: 4px;
        margin-top: 1.75rem;
    }
    .testi-stars span {
        display: block;
        width: 8px;
        height: 8px;
        background: var(--red);
        clip-path: polygon(
            50% 0%,
            61% 35%,
            98% 35%,
            68% 57%,
            79% 91%,
            50% 70%,
            21% 91%,
            32% 57%,
            2% 35%,
            39% 35%
        );
    }
    .testi-right {
        padding: 4rem;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        background: var(--off-black);
    }
    .testi-author-init {
        width: 52px;
        height: 52px;
        background: rgba(140, 10, 10, 0.25);
        border: 1px solid rgba(140, 10, 10, 0.4);
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: var(--display);
        font-size: 1.1rem;
        letter-spacing: 0.1em;
        color: var(--red-bright);
        margin-bottom: 1.5rem;
    }
    .testi-author-name {
        font-family: var(--display);
        font-size: 1.45rem;
        letter-spacing: 0.1em;
        color: var(--white);
    }
    .testi-author-role {
        font-size: 0.68rem;
        font-weight: 200;
        letter-spacing: 0.15em;
        color: var(--white-dim);
        margin-top: 0.35rem;
    }
    .testi-project-label {
        font-size: 0.58rem;
        font-weight: 300;
        letter-spacing: 0.3em;
        text-transform: uppercase;
        color: var(--red-bright);
        margin-bottom: 0.4rem;
    }
    .testi-project {
        font-size: 0.82rem;
        font-weight: 200;
        color: var(--white-dim);
        line-height: 1.6;
    }
    /* Controls */
    .testi-controls {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1.25rem 4rem;
        border-top: 1px solid var(--white-ghost);
        background: var(--panel);
    }
    .testi-dots {
        display: flex;
        gap: 8px;
        align-items: center;
    }
    .testi-dot {
        width: 20px;
        height: 2px;
        background: var(--white-ghost);
        cursor: pointer;
        transition:
            width 0.3s,
            background 0.3s;
        border: none;
        padding: 0;
    }
    .testi-dot.active {
        width: 40px;
        background: var(--red);
    }
    .testi-arrows {
        display: flex;
        gap: 0.5rem;
    }
    .testi-arrow {
        width: 40px;
        height: 40px;
        border: 1px solid var(--white-ghost);
        background: transparent;
        color: var(--white-dim);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition:
            border-color 0.3s,
            color 0.3s,
            background 0.3s;
        font-size: 0.9rem;
    }
    .testi-arrow:hover {
        border-color: var(--red);
        color: var(--white);
        background: rgba(140, 10, 10, 0.15);
    }
    .testi-progress {
        font-family: var(--display);
        font-size: 0.85rem;
        letter-spacing: 0.15em;
        color: rgba(245, 242, 238, 0.25);
    }
    .testi-progress strong {
        color: var(--white);
    }
    @media (max-width: 760px) {
        .testi-slide {
            grid-template-columns: 1fr;
        }
        .testi-right {
            border-top: 1px solid rgba(140, 10, 10, 0.3);
        }
        .testi-controls {
            padding: 1rem 1.5rem;
        }
        .testi-left,
        .testi-right {
            padding: 2.5rem 1.5rem;
        }
    }
</style>

