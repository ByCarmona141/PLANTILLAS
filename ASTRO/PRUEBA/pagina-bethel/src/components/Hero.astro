<style is:inline>
    /* ── HERO ── */
    #hero {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        position: relative;
        overflow: hidden;
        padding: 0 3rem 5rem;
    }
    .hero-noise {
        position: absolute;
        inset: 0;
        background: url("data:image/svg+xml,%3Csvg viewBox='0 0 512 512' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.75' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");
        background-size: 200px;
    }
    .hero-red-block {
        position: absolute;
        top: 0;
        right: 0;
        width: 38%;
        height: 100%;
        background: var(--red-pale);
        clip-path: polygon(15% 0, 100% 0, 100% 100%, 0% 100%);
        z-index: 0;
    }
    .hero-year-tag {
        position: absolute;
        top: 50%;
        right: 0;
        width: 38%;
        transform: translateY(-50%) translateX(-20%);
        text-align: center;
        z-index: 1;
    }
    .hero-year-tag p {
        font-family: var(--display);
        font-size: 10rem;
        color: rgba(140, 10, 10, 0.25);
        letter-spacing: 0;
        line-height: 1;
    }
    .hero-year-tag span {
        display: block;
        font-size: 0.65rem;
        font-weight: 300;
        letter-spacing: 0.4em;
        text-transform: uppercase;
        color: rgba(245, 242, 238, 0.2);
        margin-top: 0.5rem;
    }
    .hero-content {
        position: relative;
        z-index: 2;
    }
    .hero-eyebrow {
        display: flex;
        align-items: center;
        gap: 1.25rem;
        margin-bottom: 1.5rem;
    }
    .hero-eyebrow-line {
        width: 50px;
        height: 1px;
        background: var(--red);
    }
    .hero-eyebrow span {
        font-size: 0.65rem;
        font-weight: 300;
        letter-spacing: 0.35em;
        text-transform: uppercase;
        color: rgba(245, 242, 238, 0.45);
    }
    .hero-title {
        font-family: var(--display);
        font-size: clamp(4.5rem, 10vw, 10rem);
        line-height: 0.92;
        letter-spacing: 0.02em;
        color: var(--white);
        margin-bottom: 2rem;
    }
    .hero-title .accent {
        color: var(--red-bright);
    }
    .hero-title .italic-word {
        font-family: var(--italic);
        font-size: 0.8em;
        font-style: italic;
        font-weight: 400;
        letter-spacing: 0;
        color: rgba(245, 242, 238, 0.7);
    }
    .hero-bottom {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 2rem;
        flex-wrap: wrap;
    }
    .hero-desc {
        font-size: 0.88rem;
        font-weight: 300;
        line-height: 1.9;
        color: var(--white-dim);
        max-width: 400px;
        border-left: 2px solid var(--red);
        padding-left: 1.5rem;
    }
    .hero-btns {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
    }
    .btn-red {
        display: inline-block;
        background: var(--red);
        color: var(--white);
        text-decoration: none;
        font-size: 0.68rem;
        font-weight: 400;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        padding: 1rem 2rem;
        transition: background 0.3s;
    }
    .btn-red:hover {
        background: var(--red-bright);
    }
    .btn-ghost {
        display: inline-block;
        color: var(--white);
        text-decoration: none;
        font-size: 0.68rem;
        font-weight: 300;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        padding: 1rem 2rem;
        border: 1px solid var(--white-ghost);
        transition:
            border-color 0.3s,
            color 0.3s;
    }
    .btn-ghost:hover {
        border-color: rgba(245, 242, 238, 0.4);
        color: var(--white);
    }
    .scroll-down {
        position: absolute;
        right: 3rem;
        bottom: 3rem;
        z-index: 2;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.75rem;
    }
    .scroll-down span {
        font-size: 0.58rem;
        font-weight: 300;
        letter-spacing: 0.3em;
        text-transform: uppercase;
        color: rgba(245, 242, 238, 0.2);
        writing-mode: vertical-rl;
    }
    .scroll-arr {
        width: 1px;
        height: 60px;
        background: linear-gradient(to bottom, var(--red), transparent);
        animation: arr 2s ease-in-out infinite;
    }
    @keyframes arr {
        0%,
        100% {
            opacity: 0.3;
            transform: scaleY(0.5);
        }
        50% {
            opacity: 1;
            transform: scaleY(1);
        }
    }
</style>

<!-- HERO -->
<section id="hero">
    <div class="hero-noise"></div>
    <div class="hero-red-block"></div>
    <div class="hero-year-tag"><p>2001</p><span>Fundación</span></div>
    <div class="hero-content">
        <div class="hero-eyebrow">
            <div class="hero-eyebrow-line"></div>
            <span>Despacho de Arquitectura · Chilpancingo, Guerrero</span>
        </div>
        <h1 class="hero-title">
            DISEÑAMOS HOY<br />
            <span class="italic-word">pensando en el equilibrio del</span><br />
            <span class="accent">MAÑANA</span>
        </h1>
        <div class="hero-bottom">
            <p class="hero-desc">
                Más de dos décadas materializando visiones arquitectónicas con
                precisión técnica, sensibilidad creativa y compromiso con cada
                cliente.
            </p>
            <div class="hero-btns">
                <a href="#servicios" class="btn-red">Nuestros servicios</a>
                <a href="#nosotros" class="btn-ghost">Quiénes somos</a>
            </div>
        </div>
    </div>
    <div class="scroll-down">
        <div class="scroll-arr"></div>
        <span>Bajar</span>
    </div>
</section>
