<style is:inline>
    /* ── SERVICIOS ── */
    #servicios {
        padding: 7rem 3rem;
        background: var(--black-soft);
    }
    .servicios-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 5rem;
        gap: 3rem;
        flex-wrap: wrap;
    }
    .servicios-title-block {
        flex: 0 0 auto;
    }
    .big-label {
        font-family: var(--display);
        font-size: clamp(3.5rem, 7vw, 6rem);
        letter-spacing: 0.03em;
        color: var(--white);
        line-height: 0.95;
    }
    .big-label .red-stroke {
        -webkit-text-stroke: 1px var(--red);
        color: transparent;
    }
    .servicios-side {
        max-width: 380px;
    }
    .side-tag {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1.25rem;
    }
    .side-tag::before {
        content: "";
        display: block;
        width: 20px;
        height: 1px;
        background: var(--red);
    }
    .side-tag span {
        font-size: 0.62rem;
        font-weight: 300;
        letter-spacing: 0.3em;
        text-transform: uppercase;
        color: rgba(245, 242, 238, 0.4);
    }
    .side-desc {
        font-size: 0.88rem;
        font-weight: 300;
        line-height: 1.9;
        color: var(--white-dim);
    }
    /* ── SERVICE CARDS ── */
    .svc-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1px;
        background: rgba(245, 242, 238, 0.07);
        border: 1px solid rgba(245, 242, 238, 0.07);
    }
    .svc-card {
        background: var(--black-soft);
        padding: 2.25rem 2rem 2rem;
        display: flex;
        flex-direction: column;
        gap: 0;
        position: relative;
        overflow: hidden;
        transition: background 0.35s;
        cursor: default;
    }
    .svc-card::after {
        content: "";
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        height: 2px;
        background: var(--red);
        transform: scaleX(0);
        transform-origin: left;
        transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .svc-card:hover {
        background: #161616;
    }
    .svc-card:hover::after {
        transform: scaleX(1);
    }
    .svc-card:hover .svc-icon {
        opacity: 1;
        transform: translateY(-3px);
    }
    .svc-card:hover .svc-num {
        color: var(--red-bright);
    }
    .svc-icon {
        width: 44px;
        height: 44px;
        margin-bottom: 1.5rem;
        opacity: 0.45;
        transition:
            opacity 0.35s,
            transform 0.35s;
    }
    .svc-icon svg {
        width: 44px;
        height: 44px;
        display: block;
    }
    .svc-num {
        font-family: var(--display);
        font-size: 0.75rem;
        color: rgba(245, 242, 238, 0.2);
        letter-spacing: 0.18em;
        margin-bottom: 0.65rem;
        transition: color 0.3s;
    }
    .svc-name {
        font-size: 0.92rem;
        font-weight: 300;
        color: var(--white);
        letter-spacing: 0.04em;
        line-height: 1.35;
        margin-bottom: 0.9rem;
    }
    .svc-desc {
        font-size: 0.75rem;
        font-weight: 200;
        line-height: 1.85;
        color: var(--white-dim);
        margin-top: auto;
    }
    @media (max-width: 1100px) {
        .svc-grid {
            grid-template-columns: repeat(3, 1fr);
        }
    }
    @media (max-width: 760px) {
        .svc-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }
    @media (max-width: 480px) {
        .svc-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

