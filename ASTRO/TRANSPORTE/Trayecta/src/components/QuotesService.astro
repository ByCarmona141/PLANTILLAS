<style>
    /* Quote Section - COTIZACIONES */
    .quote-section {
        padding: 100px 0;
        background: white;
    }

    .quote-form {
        background: white;
        padding: 50px;
        border-radius: 20px;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.1);
    }

    .form-control,
    .form-select {
        padding: 15px 20px;
        border: 2px solid #e0e0e0;
        border-radius: 10px;
        transition: all 0.3s;
    }

    .form-control:focus,
    .form-select:focus {
        border-color: var(--primary-color);
        box-shadow: 0 0 0 0.2rem rgba(0, 102, 204, 0.15);
    }

    .quote-info {
        background: linear-gradient(
            135deg,
            var(--primary-color),
            var(--secondary-color)
        );
        padding: 50px;
        border-radius: 20px;
        color: white;
        height: 100%;
    }

    .quote-info-item {
        padding: 25px;
        background: var(--bg-secondary-color-hover);
        backdrop-filter: blur(10px);
        border-radius: 15px;
        margin-bottom: 20px;
        transition: all 0.3s;
    }

    .quote-info-item:hover {
        background: var(--bg-tertiary-color-hover);
        transform: translateX(10px);
    }

    .quote-info-item i {
        font-size: 2.5rem;
        margin-bottom: 15px;
    }

    .contact-info-card {
        background: var(--light-color);
        padding: 40px;
        border-radius: 20px;
        text-align: center;
        transition: all 0.3s;
        height: 100%;
        border: 2px solid transparent;
    }

    .contact-info-card:hover {
        border-color: var(--primary-color);
        background: white;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
        transform: translateY(-10px);
    }

    .contact-icon {
        width: 80px;
        height: 80px;
        background: linear-gradient(
            135deg,
            var(--primary-color),
            var(--secondary-color)
        );
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 20px;
        color: white;
        font-size: 2rem;
    }

    /* Quote Selection Buttons */
    .quote-selection-buttons {
        animation: fadeInDown 0.6s ease;
    }

    .btn-selection {
        padding: 15px 35px;
        font-size: 1.05rem;
        font-weight: 600;
        border: 2px solid var(--primary-color);
        color: var(--primary-color);
        background: white;
        border-radius: 50px;
        transition: all 0.3s;
        cursor: pointer;
    }

    .btn-selection:hover {
        background: var(--primary-color);
        border: 2px solid var(--primary-color);
        color: white;
        transform: translateY(-3px);
        box-shadow: 0 10px 25px rgba(168, 11, 36, 0.3);
    }

    .btn-selection.active {
        background: var(--primary-color);
        border: 2px solid var(--primary-color);
        color: white;
        box-shadow: 0 10px 25px rgba(168, 11, 36, 0.3);
    }

    .btn-form {
        border-color: var(--primary-color);
    }

    /* WhatsApp Contact Container */
    .whatsapp-contact-container {
        animation: fadeInUp 0.6s ease;
    }

    .whatsapp-info {
        text-align: center;
    }

    @keyframes pulse {
        0%,
        100% {
            transform: scale(1);
        }
        50% {
            transform: scale(1.05);
        }
    }

    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @keyframes fadeInDown {
        from {
            opacity: 0;
            transform: translateY(-20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<section class="quote-section" id="cotizaciones">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="section-title" data-translate="quote_title">
                Solicita tu Cotización
            </h2>
            <p class="section-subtitle" data-translate="quote_subtitle">
                Obtén una cotización personalizada en minutos
            </p>
            <div class="d-flex justify-content-center">
                <a
                    href="https://wa.me/2223716661?text=Estoy interesado en un *servicio de carga terrestre nacional*"
                    target="_blank"
                    class="btn custom-btn-tertiary mt-3"
                >
                    <i class="fa-brands fa-whatsapp"></i>
                    <span data-translate="land_national_service_btn"
                        >Cotizar Servicio</span
                    >
                </a>
            </div>
        </div>
        <div class="row">
            <div class="col-lg-7 mb-4 mb-lg-0">
                <div class="quote-form">
                    <form
                        id="quoteForm"
                        action="https://formspree.io/f/xwpwgawo"
                        method="POST"
                    >
                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <label
                                    class="form-label fw-bold"
                                    data-translate="quote_name"
                                    >Nombre Completo</label
                                >
                                <input
                                    type="text"
                                    name="name"
                                    class="form-control"
                                    required
                                />
                            </div>
                            <div class="col-md-6 mb-4">
                                <label
                                    class="form-label fw-bold"
                                    data-translate="quote_email"
                                    >Correo Electrónico</label
                                >
                                <input
                                    type="email"
                                    name="email"
                                    class="form-control"
                                    required
                                />
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <label
                                    class="form-label fw-bold"
                                    data-translate="quote_phone">Teléfono</label
                                >
                                <input
                                    type="tel"
                                    name="phone"
                                    class="form-control"
                                    required
                                />
                            </div>
                            <div class="col-md-6 mb-4">
                                <label
                                    class="form-label fw-bold"
                                    data-translate="quote_weight"
                                    >Peso Aproximado (kg)</label
                                >
                                <input
                                    type="number"
                                    name="weight"
                                    class="form-control"
                                    min="0"
                                    step="0.1"
                                    required
                                />
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <label
                                    class="form-label fw-bold"
                                    data-translate="quote_origin"
                                    >Ciudad de Origen</label
                                >
                                <input
                                    type="text"
                                    name="origin"
                                    class="form-control"
                                    required
                                />
                            </div>
                            <div class="col-md-6 mb-4">
                                <label
                                    class="form-label fw-bold"
                                    data-translate="quote_destination"
                                    >Ciudad de Destino</label
                                >
                                <input
                                    type="text"
                                    name="destination"
                                    class="form-control"
                                    required
                                />
                            </div>
                        </div>
                        <div class="mb-4">
                            <label
                                class="form-label fw-bold"
                                data-translate="quote_message"
                                >Mensaje Adicional</label
                            >
                            <textarea
                                class="form-control"
                                name="message"
                                rows="4"></textarea>
                        </div>
                        <button
                            type="submit"
                            class="btn custom-btn-tertiary btn-lg w-100"
                        >
                            <i class="fas fa-paper-plane me-2"></i>
                            <span data-translate="quote_btn"
                                >Solicitar Cotización Gratis</span
                            >
                        </button>
                    </form>
                </div>

                <div class="row g-4 mt-2">
                    <div class="col-lg-6 col-md-6">
                        <div class="contact-info-card">
                            <div class="contact-icon">
                                <i class="fas fa-map-marker-alt"></i>
                            </div>
                            <h4 data-translate="land_national_contact_address">
                                Dirección
                            </h4>
                            <p class="text-muted">
                                Blvd. Sinfonía 3D, int. 107. Lomas de
                                Angelópolis. <br /> San Andrés Cholula, Puebla. CP. 72830
                            </p>
                        </div>
                    </div>
                    <div class="col-lg-6 col-md-6">
                        <div class="contact-info-card">
                            <div class="contact-icon">
                                <i class="fas fa-clock"></i>
                            </div>
                            <h4
                                data-translate="land_national_contact_schedule_title"
                            >
                                Horario de atención
                            </h4>
                            <p class="text-muted">
                                <span
                                    data-translate="land_national_contact_schedule_week"
                                    >Lun - Vie: 9:00 AM - 6:00 PM</span
                                >
                            </p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="quote-info">
                    <h3 class="mb-4" data-translate="quote_info_title">
                        ¿Por qué cotizar con nosotros?
                    </h3>
                    <div class="quote-info-item">
                        <i class="fas fa-bolt"></i>
                        <h5 data-translate="quote_info1_title">
                            Respuesta Inmediata
                        </h5>
                        <p class="mb-0" data-translate="quote_info1_desc">
                            Recibirás tu cotización en el menor tiempo posible
                        </p>
                    </div>
                    <div class="quote-info-item">
                        <i class="fas fa-dollar-sign"></i>
                        <h5 data-translate="quote_info2_title">
                            Precios Competitivos
                        </h5>
                        <p class="mb-0" data-translate="quote_info2_desc">
                            Las mejores tarifas del mercado sin costos ocultos
                        </p>
                    </div>
                    <div class="quote-info-item">
                        <i class="fas fa-user-tie"></i>
                        <h5 data-translate="quote_info3_title">
                            Asesoría Personalizada
                        </h5>
                        <p class="mb-0" data-translate="quote_info3_desc">
                            Un experto te acompañará en todo el proceso
                        </p>
                    </div>
                    <div class="quote-info-item">
                        <i class="fas fa-shield-alt"></i>
                        <h5 data-translate="quote_info4_title">
                            Sin Compromiso
                        </h5>
                        <p class="mb-0" data-translate="quote_info4_desc">
                            Cotización 100% gratuita y sin obligación
                        </p>
                    </div>
                    <div class="mt-4 pt-4 border-top border-light">
                        <p class="mb-2">
                            <i class="fas fa-phone me-2"></i>
                            +52 222 371 6661
                        </p>
                        <p class="mb-2">
                            <i class="fas fa-envelope me-2"></i>
                            ventas1@igsforwarding.com.mx
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
