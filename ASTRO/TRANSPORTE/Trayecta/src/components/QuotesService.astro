<style>
    /* Quote Section - COTIZACIONES */
    .quote-section {
        padding: 100px 0;
        background: white;
    }

    .quote-form {
        background: white;
        padding: 50px;
        border-radius: 20px;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.1);
    }

    .form-control,
    .form-select {
        padding: 15px 20px;
        border: 2px solid #e0e0e0;
        border-radius: 10px;
        transition: all 0.3s;
    }

    .form-control:focus,
    .form-select:focus {
        border-color: var(--primary-color);
        box-shadow: 0 0 0 0.2rem rgba(0, 102, 204, 0.15);
    }

    .quote-info {
        background: linear-gradient(
            135deg,
            var(--primary-color),
            var(--secondary-color)
        );
        padding: 50px;
        border-radius: 20px;
        color: white;
        height: 100%;
    }

    .quote-info-item {
        padding: 25px;
        background: var(--bg-secondary-color-hover);
        backdrop-filter: blur(10px);
        border-radius: 15px;
        margin-bottom: 20px;
        transition: all 0.3s;

        &:hover {
            background: var(--bg-tertiary-color-hover);
            transform: translateX(10px);
        }

        i {
            font-size: 2.5rem;
            margin-bottom: 15px;
        }
    }

    /* Info bottom row */
    .info-card {
        background: #f8f9fa;
        border-radius: 18px;
        padding: 35px 30px;
        height: 100%;
        transition: all 0.3s;
        border: 2px solid transparent;

        &:hover {
            border-color: var(--primary-color);
            background: white;
            box-shadow: 0 10px 35px rgba(10, 62, 142, 0.1);
        }
    }

    .info-card-icon {
        width: 52px;
        height: 52px;
        background: linear-gradient(
            135deg,
            var(--primary-color),
            var(--secondary-color)
        );
        border-radius: 13px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--light-color);
        font-size: 1.3rem;
        margin-bottom: 18px;
    }

    .info-card h5 {
        text-align: center;
        font-size: 1rem;
        font-weight: 700;
        color: var(--secondary-color);
        margin-bottom: 10px;
    }

    .info-card p,
    .info-card address {
        font-size: 0.9rem;
        color: #666;
        line-height: 1.8;
        margin: 0;
        font-style: normal;
    }

    .schedule-row {
        display: flex;
        justify-content: space-between;
        font-size: 0.88rem;
        padding: 6px 0;
        border-bottom: 1px solid #f0f0f0;
        color: #555;
    }

    .schedule-row:last-child {
        border-bottom: none;
    }

    .schedule-row .day {
        font-weight: 600;
        color: var(--secondary-color);
    }

    .schedule-open {
        background: #ecfdf5;
        color: #16a34a;
        font-size: 0.7rem;
        font-weight: 700;
        padding: 2px 8px;
        border-radius: 20px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .schedule-close {
        background: #fdecec;
        color: #a00b0b;
        font-size: 0.7rem;
        font-weight: 700;
        padding: 2px 8px;
        border-radius: 20px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    /* Quote Selection Buttons */
    .quote-selection-buttons {
        animation: fadeInDown 0.6s ease;
    }

    .btn-selection {
        padding: 15px 35px;
        font-size: 1.05rem;
        font-weight: 600;
        border: 2px solid var(--primary-color);
        color: var(--primary-color);
        background: white;
        border-radius: 50px;
        transition: all 0.3s;
        cursor: pointer;

        &:hover {
            background: var(--primary-color);
            border: 2px solid var(--primary-color);
            color: white;
            transform: translateY(-3px);
            box-shadow: 0 10px 25px var(--bg-primary-color-hover);
        }

        &.active {
            background: var(--primary-color);
            border: 2px solid var(--primary-color);
            color: white;
            box-shadow: 0 10px 25px var(--bg-primary-color-hover);
        }
    }

    .btn-form {
        border-color: var(--primary-color);
    }

    /* WhatsApp Contact Container */
    .whatsapp-contact-container {
        animation: fadeInUp 0.6s ease;
    }

    .whatsapp-info {
        text-align: center;
    }

    @keyframes pulse {
        0%,
        100% {
            transform: scale(1);
        }
        50% {
            transform: scale(1.05);
        }
    }

    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @keyframes fadeInDown {
        from {
            opacity: 0;
            transform: translateY(-20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* WhatsApp Button Cards */
    .whatsapp-btn {
        padding: 15px 40px;
        font-weight: 600;
        border-radius: 50px;
        transition: all 0.3s;
        text-transform: uppercase;
        letter-spacing: 1px;
        border: 2px solid var(--bg-tertiary-button);
        color: var(--tertiary-button-text);
    }

    .whatsapp-btn:hover {
        background-color: var(--bg-tertiary-button-hover);
        color: var(--tertiary-button-text-hover);
    }

    .whatsapp-card {
        background: var(--light-color);
        padding: 40px;
        border-radius: 20px;
        text-align: center;
        transition: all 0.3s;
        height: 100%;
        border: 2px solid transparent;
    }

    .whatsapp-card:hover {
        border-color: var(--primary-color);
        background: var(--light-color);
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
        transform: translateY(-10px);
    }

    .whatsapp-icon {
        width: 80px;
        height: 80px;
        background: linear-gradient(
            135deg,
            var(--primary-color),
            var(--secondary-color)
        );
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 20px;
        color: white;
        font-size: 2rem;
    }

    .whatsapp-button-card {
        background: white;
        padding: 25px;
        border-radius: 15px;
        text-align: center;
        border: 2px solid transparent;
        transition: all 0.3s;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.08);
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .whatsapp-button-card:hover {
        border-color: #25d366;
        box-shadow: 0 10px 30px rgba(37, 211, 102, 0.2);
        transform: translateY(-5px);
    }

    .whatsapp-button-card i {
        font-size: 2.5rem;
        color: var(--primary-color);
        margin-bottom: 15px;
    }

    .whatsapp-button-card h6 {
        font-weight: 700;
        color: var(--dark-color);
        margin-bottom: 15px;
        flex-grow: 1;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .whatsapp-button-card .btn {
        padding: 15px 40px;
        font-weight: 600;
        border-radius: 50px;
        transition: all 0.3s;
        text-transform: uppercase;
        letter-spacing: 1px;
        border: 2px solid var(--bg-tertiary-button);
        color: var(--tertiary-button-text);
    }

    .whatsapp-button-card .btn:hover {
        background-color: var(--bg-tertiary-button-hover);
        color: var(--tertiary-button-text-hover);
    }

    .whatsapp-button-card .btn i {
        font-size: 1rem;
    }

    /* Contact channel cards */
    .channel-card {
        background: #f8f9fa;
        border: 2px solid transparent;
        border-radius: 18px;
        padding: 30px 25px;
        text-align: center;
        text-decoration: none;
        color: inherit;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 12px;
        transition: all 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
        height: 100%;
    }

    .channel-card:hover {
        background: white;
        border-color: var(--primary-color);
        box-shadow: 0 12px 40px rgba(10, 62, 142, 0.15);
        transform: translateY(-8px);
        color: inherit;
    }

    .channel-icon {
        width: 64px;
        height: 64px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.7rem;
        color: white;
        transition: all 0.3s;
    }

    .channel-card:hover .channel-icon {
        transform: scale(1.1);
    }

    .icon-whatsapp {
        background: linear-gradient(135deg, #25d366, #128c7e);
    }
    .icon-email {
        background: linear-gradient(
            135deg,
            var(--primary-color),
            var(--secondary-color)
        );
    }

    .channel-label {
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #999;
    }

    .channel-title {
        font-size: 1rem;
        font-weight: 700;
        color: var(--secondary-color);
        margin: 0;
    }

    .channel-detail {
        font-size: 0.85rem;
        color: #777;
        margin: 0;
    }

    .channel-card-lg {
        padding: 45px 35px;
        gap: 14px;
    }

    .channel-icon-lg {
        width: 90px;
        height: 90px;
        border-radius: 22px;
        font-size: 2.4rem;
    }

    .channel-title-lg {
        font-size: 1.4rem !important;
    }

    .channel-cta {
        margin-top: 8px;
        font-size: 0.88rem;
        font-weight: 700;
        color: var(--primary-color);
        letter-spacing: 0.3px;
        opacity: 0;
        transform: translateY(6px);
        transition: all 0.3s ease;
    }

    .channel-card:hover .channel-cta {
        opacity: 1;
        transform: translateY(0);
    }

    .btn-whatsapp-cta .channel-cta {
        color: #128c7e;
    }

    /* Alert Info */
    .alert-info {
        background: #e7f3ff;
        border: 2px solid #25d366;
        border-radius: 10px;
        color: #0066cc;

        i {
            color: #25d366;
        }
    }

    /* Transiciones suaves */
    #form-view,
    #whatsapp-view {
        transition: all 0.4s ease;
    }

    /* Responsive */
    @media (max-width: 768px) {
        .btn-selection {
            padding: 12px 25px;
            font-size: 0.95rem;
        }

        .whatsapp-button-card {
            padding: 20px;
        }

        .whatsapp-button-card i {
            font-size: 2rem;
        }
    }
</style>

