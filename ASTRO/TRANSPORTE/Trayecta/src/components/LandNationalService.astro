<script is:inline>
    function showCategory(category) {
        // Ocultar todas las grids
        document.querySelectorAll(".units-grid").forEach((grid) => {
            grid.classList.remove("active");
        });

        // Remover active de todos los tabs
        document.querySelectorAll(".category-tab").forEach((tab) => {
            tab.classList.remove("active");
        });

        // Mostrar la grid seleccionada
        const selectedGrid = document.getElementById(category);
        if (selectedGrid) {
            selectedGrid.classList.add("active");
        }

        // Encontrar el botón correcto y activarlo
        // Buscar el botón que tiene el onclick con esta categoría
        document.querySelectorAll(".category-tab").forEach((tab) => {
            const onclickAttr = tab.getAttribute("onclick");
            if (onclickAttr && onclickAttr.includes(`'${category}'`)) {
                tab.classList.add("active");
            }
        });
    }
</script>
