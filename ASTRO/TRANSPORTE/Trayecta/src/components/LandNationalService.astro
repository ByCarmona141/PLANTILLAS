---
interface Props {
    company: string;
}

const { company } = Astro.props;
---

<style>
    /* Hero Section - INICIO */
    .hero-section {
        background: linear-gradient(
            135deg,
            var(--secondary-color) 0%,
            var(--secondary-color) 100%
        );
        color: white;
        padding: 60px 0;
        position: relative;
        overflow: hidden;
        height: 50vh;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-top: -70px;
        padding-top: 130px;
    }

    .hero-main-content {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .full-width-half-height {
        height: 50vh;
        width: 100vw;
    }

    .full-width-half-height .carousel-inner {
        height: 100%;
    }

    .full-width-half-height .carousel-item {
        height: 100%;
    }

    .full-width-half-height .carousel-item img {
        height: 100%;
        object-fit: cover;
    }

    .carousel-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .carousel-item {
        position: relative;
        overflow: hidden;
    }

    .carousel-item::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: linear-gradient(
            135deg,
            var(--bg-primary-color-hover),
            var(--bg-secondary-color-hover)
        );
        z-index: 1;
    }

    .carousel-caption {
        z-index: 2;
    }

    .carousel-title {
        font-size: 3.5rem;
        font-weight: 700;
        margin-bottom: 20px;
        animation: fadeInUp 0.8s ease;
    }

    .carousel-subtitle {
        text-align: center;
        font-size: 1.4rem;
        margin-bottom: 30px;
        opacity: 0.95;
        animation: fadeInUp 1s ease;
    }
    /* Service Page Styles */

    /* Navbar Active State Override */
    .navbar .nav-link {
        color: var(--light-color) !important;
    }

    .navbar .nav-link:hover {
        color: var(--tertiary-color) !important;
    }

    .navbar .nav-link.active {
        color: var(--primary-color) !important;
    }

    .navbar .nav-link::after {
        background: var(--tertiary-color);
    }

    .bg-dark {
        background-color: var(--dark-color) !important;
    }

    /* Hero Section */
    .service-hero {
        padding: 180px 0 120px;
        color: white;
        position: relative;
        background:
            linear-gradient(135deg, rgba(0, 102, 204, 0.9), rgba(0, 0, 0, 0.8)),
            url("../assets/image/maritime/img1.jpg");
        background-size: cover;
        background-position: center;
    }

    .service-hero::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: linear-gradient(
            135deg,
            rgba(168, 11, 36, 0.85),
            rgba(0, 0, 0, 0.85)
        );
        z-index: 1;
    }

    .service-hero .container {
        position: relative;
        z-index: 2;
    }

    .service-hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        background: rgba(255, 255, 255, 0.2);
        backdrop-filter: blur(10px);
        padding: 12px 24px;
        border-radius: 50px;
        margin-bottom: 20px;
        font-weight: 600;
        animation: fadeInUp 0.6s ease;
    }

    .service-hero-badge i {
        font-size: 1.5rem;
    }

    .service-hero-title {
        font-size: 3.5rem;
        font-weight: 700;
        margin-bottom: 25px;
        animation: fadeInUp 0.8s ease;
    }

    .service-hero-subtitle {
        font-size: 1.3rem;
        line-height: 1.8;
        margin-bottom: 30px;
        opacity: 0.95;
        animation: fadeInUp 1s ease;
    }

    /* Service Section */
    .service-section {
        padding: 80px 0;
    }

    /* Port Cards */
    .port-card {
        background: white;
        padding: 40px;
        border-radius: 20px;
        text-align: center;
        transition: all 0.3s;
        height: 100%;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
    }

    .port-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 15px 40px rgba(0, 0, 0, 0.15);
    }

    .port-icon {
        width: 80px;
        height: 80px;
        background: linear-gradient(
            135deg,
            var(--primary-color),
            var(--secondary-color)
        );
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 20px;
        color: white;
        font-size: 2rem;
    }

    .port-card h4 {
        margin-bottom: 10px;
        color: var(--dark-color);
    }

    /* Coverage Cards */
    .coverage-card {
        background: linear-gradient(
            135deg,
            var(--primary-color),
            var(--secondary-color)
        );
        color: white;
        padding: 50px 30px;
        border-radius: 20px;
        text-align: center;
        transition: all 0.3s;
        height: 100%;
    }

    .coverage-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.2);
    }

    .coverage-number {
        font-size: 4rem;
        font-weight: 700;
        margin-bottom: 20px;
        opacity: 0.95;
    }

    .coverage-card h4 {
        font-size: 1.5rem;
        margin-bottom: 15px;
    }

    .coverage-card p {
        opacity: 0.9;
        line-height: 1.6;
    }

    /* Service Modality */
    .service-modality {
        padding: 60px 0;
    }

    .modality-icon-box {
        background: linear-gradient(
            135deg,
            var(--primary-color),
            var(--secondary-color)
        );
        border-radius: 30px;
        padding: 80px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 6rem;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.15);
    }

    .modality-badge {
        display: inline-block;
        background: var(--primary-color);
        color: white;
        padding: 8px 20px;
        border-radius: 50px;
        font-size: 0.9rem;
        font-weight: 600;
        margin-bottom: 15px;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .modality-title {
        font-size: 2.5rem;
        font-weight: 700;
        margin-bottom: 20px;
        color: var(--dark-color);
    }

    .modality-desc {
        font-size: 1.2rem;
        color: #666;
        margin-bottom: 30px;
    }

    .modality-features {
        list-style: none;
        padding: 0;
        margin-bottom: 20px;
    }

    .modality-features li {
        padding: 15px 0;
        border-bottom: 1px solid #e0e0e0;
        display: flex;
        align-items: center;
        font-size: 1.05rem;
    }

    .modality-features li:last-child {
        border-bottom: none;
    }

    .modality-features i {
        color: var(--primary-color);
        font-size: 1.3rem;
        margin-right: 15px;
        min-width: 30px;
    }

    .sub-features {
        list-style: none;
        padding-left: 20px;
    }

    .sub-features li {
        padding: 10px 0;
        color: #666;
    }

    /* Support Cards */
    .support-card {
        border: 2px solid var(--primary-color);
        background: white;
        padding: 40px 30px;
        border-radius: 20px;
        text-align: center;
        transition: all 0.3s;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
        height: 100%;
    }

    .support-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 15px 40px rgba(0, 0, 0, 0.15);
        background: var(--primary-color);
        color: white;
    }

    .support-card i {
        font-size: 3rem;
        color: var(--primary-color);
        margin-bottom: 20px;
        transition: all 0.3s;
    }

    .support-card:hover i {
        color: white;
    }

    .support-card h5 {
        font-size: 1.1rem;
        font-weight: 600;
    }

    /* Customs Clearance Cards */
    .custom-clearance-card {
        border: 2px solid var(--primary-color);
        background: white;
        padding: 40px 30px;
        border-radius: 20px;
        text-align: center;
        transition: all 0.3s;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
        height: 100%;
    }

    .custom-clearance-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 15px 40px rgba(0, 0, 0, 0.15);
        background: var(--primary-color);
        color: white;
    }

    .custom-clearance-card i {
        font-size: 3rem;
        color: var(--primary-color);
        margin-bottom: 20px;
        transition: all 0.3s;
    }

    .custom-clearance-card:hover i {
        color: white;
    }

    .custom-clearance-card h5 {
        font-size: 1.1rem;
        font-weight: 600;
    }

    /* Advantage Cards */
    .advantage-card {
        background: var(--bg-tertiary-color);
        backdrop-filter: blur(10px);
        padding: 40px 30px;
        border-radius: 20px;
        text-align: center;
        transition: all 0.3s;
        border: 2px solid rgba(255, 255, 255, 0.2);
    }

    .advantage-card:hover {
        background: var(--primary-color);
        transform: translateY(-10px);
    }

    .advantage-card:hover i,
    .advantage-card:hover h5 {
        color: var(--bg-tertiary-color);
    }

    .advantage-card i {
        font-size: 3rem;
        margin-bottom: 20px;
        color: var(--secondary-color);
    }

    .advantage-card h5 {
        font-size: 1.1rem;
        font-weight: 600;
        color: var(--secondary-color);
    }

    /* CTA Section */
    .cta-section {
        padding: 100px 0;
        background: linear-gradient(
            135deg,
            var(--primary-color),
            var(--secondary-color)
        );
        color: white;
    }

    .cta-section h2 {
        font-size: 3rem;
        font-weight: 700;
    }

    .cta-section .lead {
        font-size: 1.3rem;
        opacity: 0.95;
    }

    /* Responsive */
    @media (max-width: 768px) {
        .service-hero {
            padding: 140px 0 80px;
        }

        .service-hero-title {
            font-size: 2.2rem;
        }

        .service-hero-subtitle {
            font-size: 1.1rem;
        }

        .modality-icon-box {
            padding: 60px;
            font-size: 4rem;
        }

        .modality-title {
            font-size: 1.8rem;
        }

        .coverage-number {
            font-size: 3rem;
        }

        .cta-section h2 {
            font-size: 2rem;
        }
    }

    /* Land Service Section */
    .land-service-section {
        background: rgba(255, 255, 255, 0.2);
        padding: 80px 20px;
        position: relative;
        overflow: hidden;
    }

    .land-container {
        max-width: 1400px;
        margin: 0 auto;
        position: relative;
        z-index: 2;
    }

    .land-header {
        text-align: center;
        margin-bottom: 60px;

        h2 {
            font-size: 2.5rem;
            font-weight: 700;
            color: var(--secondary-color);
            margin-bottom: 15px;
            position: relative;
            display: inline-block;
        }

        p {
            font-size: 1.1rem;
            color: #666;
            margin-top: 25px;
            max-width: 700px;
            margin-left: auto;
            margin-right: auto;
        }
    }

    @media (min-width: 768px) {
        .land-header h2 {
            font-size: 3rem;
        }
    }

    .own-fleet-badge {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        background: linear-gradient(
            135deg,
            var(--primary-color),
            var(--secondary-color)
        );
        color: var(--light-color);
        padding: 15px 30px;
        border-radius: 50px;
        font-size: 1.1rem;
        font-weight: 700;
        margin-top: 20px;
        box-shadow: 0 5px 20px var(--bg-primary-color-hover);
        animation: pulse-badge 2s ease-in-out infinite;

        i {
            font-size: 1.3rem;
        }
    }

    @keyframes pulse-badge {
        0%,
        100% {
            transform: scale(1);
            box-shadow: 0 5px 20px var(--bg-primary-color-hover);
        }
        50% {
            transform: scale(1.05);
            box-shadow: 0 10px 30px var(--bg-primary-color-hover);
        }
    }

    /* Tabs de Categorías */
    .category-tabs {
        display: flex;
        justify-content: center;
        gap: 15px;
        margin-bottom: 50px;
        flex-wrap: wrap;
    }

    .category-tab {
        padding: 15px 40px;
        font-weight: 600;
        border-radius: 50px;
        transition: all 0.3s;
        text-transform: uppercase;
        letter-spacing: 1px;
        border: 2px solid var(--bg-tertiary-button);
        color: var(--tertiary-button-text);
    }

    .category-tab:hover {
        background-color: var(--bg-tertiary-button-hover);
        color: var(--tertiary-button-text-hover);
        transform: translateY(-3px);
    }

    .category-tab.active {
        background-color: var(--bg-tertiary-button-hover);
        color: var(--tertiary-button-text-hover);
        border-color: var(--primary-color);
    }

    /* Grid de Unidades */
    .units-grid {
        display: none;
        grid-template-columns: 1fr;
        gap: 30px;
        margin-top: 40px;
    }

    .units-grid.active {
        display: grid;
        animation: fadeIn 0.5s ease-out;
    }

    .units-grid#plataformas {
        justify-content: center;
    }

    @media (min-width: 768px) {
        .units-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .units-grid#plataformas {
            grid-template-columns: repeat(3, 1fr);
            max-width: 1000px;
            margin-left: auto;
            margin-right: auto;
        }
    }

    @media (min-width: 1200px) {
        .units-grid {
            grid-template-columns: repeat(4, 1fr);
        }

        .units-grid#plataformas {
            grid-template-columns: repeat(3, 1fr);
            max-width: 1100px;
        }
    }

    @keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Card de Unidad */
    .unit-card {
        background: white;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
        transition: all 0.3s ease;
        border: 2px solid transparent;

        &:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 50px var(--bg-primary-color-hover);
            border-color: var(--primary-color);
        }
    }

    .unit-content {
        padding: 25px;
    }

    .unit-title {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--secondary-color);
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .unit-title i {
        color: var(--primary-color);
    }

    .unit-specs {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .unit-specs li {
        padding: 10px 0;
        border-bottom: 1px solid #f0f0f0;
        display: flex;
        align-items: flex-start;
        gap: 10px;
        color: #555;
    }

    .unit-specs li:last-child {
        border-bottom: none;
    }

    .unit-specs li i {
        color: var(--primary-color);
        margin-top: 3px;
        flex-shrink: 0;
    }

    .unit-specs li strong {
        color: var(--secondary-color);
        min-width: 80px;
    }

    .unit-highlight {
        background: linear-gradient(
            135deg,
            var(--bg-primary-color-hover),
            rgba(0, 0, 0, 0.05)
        );
        padding: 15px;
        border-radius: 10px;
        margin-top: 20px;
        text-align: center;

        i {
            color: var(--primary-color);
            font-size: 1.5rem;
            margin-bottom: 8px;
        }

        strong {
            display: block;
            color: var(--secondary-color);
            font-size: 1.1rem;
        }
    }

    @media (max-width: 768px) {
        .land-service-section {
            padding: 60px 15px;
        }

        .unit-card {
            margin-bottom: 0;
        }

        .category-tabs {
            gap: 10px;
        }

        .category-tab {
            padding: 10px 20px;
            font-size: 0.9rem;
        }
    }
</style>

<section id="servicios">
    <div class="container-fluid p-0">
        <div
            id="carouselCaptions"
            class="carousel slide full-width-half-height"
            data-bs-ride="carousel"
        >
            <div class="carousel-indicators">
                <button
                    type="button"
                    data-bs-target="#carouselCaptions"
                    data-bs-slide-to="0"
                    class="active"
                    aria-current="true"
                    aria-label="Slide 1"></button>
                <button
                    type="button"
                    data-bs-target="#carouselCaptions"
                    data-bs-slide-to="1"
                    aria-label="Slide 2"></button>
                <button
                    type="button"
                    data-bs-target="#carouselCaptions"
                    data-bs-slide-to="2"
                    aria-label="Slide 3"></button>
            </div>
            <div class="carousel-inner">
                <div class="carousel-item active" data-bs-interval="4000">
                    <img
                        src="../assets/image/land/img5.webp"
                        class="d-block w-100 carousel-img"
                        alt="maritime1"
                    />
                    <div class="carousel-caption d-none d-md-block">
                        <h5
                            class="carousel-title"
                            data-translate="land_national_carousel_title"
                        >
                            Servicio Terrestre Nacional
                        </h5>
                        <p
                            class="carousel-subtitle"
                            data-translate="land_national_carousel_subtitle"
                        >
                            Somos una empresa especializada en transporte
                            terrestre nacional FTL (Full Truck Load), enfocada
                            en el traslado eficiente y seguro de carga completa.
                        </p>
                    </div>
                </div>
                <div class="carousel-item" data-bs-interval="4000">
                    <img
                        src="../assets/image/land/img6.webp"
                        class="d-block w-100 carousel-img"
                        alt="maritime2"
                    />
                    <div class="carousel-caption d-none d-md-block">
                        <h5
                            class="carousel-title"
                            data-translate="land_national_carousel_title"
                        >
                            Servicio Terrestre Nacional
                        </h5>
                        <p
                            class="carousel-subtitle"
                            data-translate="land_national_carousel_subtitle"
                        >
                            Somos una empresa especializada en transporte
                            terrestre nacional FTL (Full Truck Load), enfocada
                            en el traslado eficiente y seguro de carga completa.
                        </p>
                    </div>
                </div>
                <div class="carousel-item" data-bs-interval="4000">
                    <img
                        src="../assets/image/land/img7.webp"
                        class="d-block w-100 carousel-img"
                        alt="maritime3"
                    />
                    <div class="carousel-caption d-none d-md-block">
                        <h5
                            class="carousel-title"
                            data-translate="land_national_carousel_title"
                        >
                            Servicio Terrestre Nacional
                        </h5>
                        <p
                            class="carousel-subtitle"
                            data-translate="land_national_carousel_subtitle"
                        >
                            Somos una empresa especializada en transporte
                            terrestre nacional FTL (Full Truck Load), enfocada
                            en el traslado eficiente y seguro de carga completa.
                        </p>
                    </div>
                </div>
            </div>
            <button
                class="carousel-control-prev"
                type="button"
                data-bs-target="#carouselCaptions"
                data-bs-slide="prev"
            >
                <span class="carousel-control-prev-icon" aria-hidden="true"
                ></span>
                <span class="visually-hidden">Previous</span>
            </button>
            <button
                class="carousel-control-next"
                type="button"
                data-bs-target="#carouselCaptions"
                data-bs-slide="next"
            >
                <span class="carousel-control-next-icon" aria-hidden="true"
                ></span>
                <span class="visually-hidden">Next</span>
            </button>
        </div>
    </div>

    <!-- Rutas de Operación -->
    <section class="service-section">
        <div class="container">
            <div class="text-center mb-5">
                <h2
                    class="section-title"
                    data-translate="land_national_paths_title"
                >
                    Rutas de Operación en México
                </h2>
                <p
                    class="section-subtitle"
                    data-translate="land_national_paths_subtitle"
                >
                    Operamos a nivel nacional, conectando los principales
                    corredores industriales y centros productivos del país.
                </p>
            </div>
            <div class="row g-4">
                <div class="col-md-6 col-lg-4">
                    <div class="port-card">
                        <div class="port-icon">
                            <i class="fa-solid fa-location-dot"></i>
                        </div>
                        <h4 data-translate="land_national_path1">Centro</h4>
                        <p
                            class="text-muted small"
                            data-translate="land_national_path_destinations1"
                        >
                            Puebla / Tlaxcala / Ciudad de México / Estado de
                            México
                        </p>
                    </div>
                </div>
                <div class="col-md-6 col-lg-4">
                    <div class="port-card">
                        <div class="port-icon">
                            <i class="fa-solid fa-location-dot"></i>
                        </div>
                        <h4 data-translate="land_national_path2">Bajío</h4>
                        <p
                            class="text-muted small"
                            data-translate="land_national_path_destinations2"
                        >
                            Querétaro / Celaya / Silao / Irapuato / San Luis
                            Potosí / Aguascalientes
                        </p>
                    </div>
                </div>
                <div class="col-md-6 col-lg-4">
                    <div class="port-card">
                        <div class="port-icon">
                            <i class="fa-solid fa-location-dot"></i>
                        </div>
                        <h4 data-translate="land_national_path3">Occidente</h4>
                        <p
                            class="text-muted small"
                            data-translate="land_national_path_destinations3"
                        >
                            Guadalajara
                        </p>
                    </div>
                </div>
                <div class="col-md-6 col-lg-4">
                    <div class="port-card">
                        <div class="port-icon">
                            <i class="fa-solid fa-location-dot"></i>
                        </div>
                        <h4 data-translate="land_national_path4">Norte</h4>
                        <p
                            class="text-muted small"
                            data-translate="land_national_path_destinations4"
                        >
                            Saltillo / Ramos Arizpe / Monterrey / Cd Juarez
                        </p>
                    </div>
