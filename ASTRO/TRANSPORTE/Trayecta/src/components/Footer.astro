---
interface Props {
    company: string;
}

const { company } = Astro.props;
---

<style>
    /* Footer */
    footer {
        background: var(--dark-color);
        color: white;
        padding: 60px 0 30px;
    }

    footer a {
        color: #ccc;
        text-decoration: none;
        transition: color 0.3s;
    }

    footer a:hover {
        color: var(--secondary-color);
    }

    .footer-logo {
        font-size: 1.8rem;
        font-weight: 700;
        color: white;
        margin-bottom: 20px;
    }

    .social-links a {
        display: inline-block;
        width: 45px;
        height: 45px;
        background: rgba(255, 255, 255, 0.1);
        border-radius: 50%;
        text-align: center;
        line-height: 45px;
        margin-right: 10px;
        transition: all 0.3s;
    }

    .social-links a:hover {
        background: var(--secondary-color);
        transform: translateY(-5px);
    }

    .author:hover {
        color: var(--primary-color) !important;
    }
</style>

<footer>
    <div class="container">
        <div class="row">
            <div class="col-lg-5 mb-4">
                <div class="footer-logo">
                    <img src="/favicon.ico" alt="Logo" width="50" height="50" />
                    {company}
                </div>
                <p data-translate="footer_desc">
                    Líder en servicios logísticos, con más de 15 años de
                    experiencia. Conectamos México con el mundo de manera
                    rápida, segura y confiable.
                </p>
                <!-- 
                <div class="social-links mt-4">
                    <a class="link" href="#" aria-label="Facebook">
                        <i class="fab fa-facebook-f"></i>
                    </a>
                    <a class="link" href="#" aria-label="Twitter">
                        <i class="fab fa-twitter"></i>
                    </a>
                    <a class="link" href="#" aria-label="Instagram">
                        <i class="fab fa-instagram"></i>
                    </a>
                    <a class="link" href="#" aria-label="LinkedIn">
                        <i class="fab fa-linkedin-in"></i>
                    </a>
                </div>
                -->
            </div>
            <div class="col-lg-2 col-md-6 mb-4">
                <h5 class="mb-3" data-translate="footer_services">Servicios</h5>
                <ul class="list-unstyled">
                    <li class="mb-2">
                        <a
                            class="link"
                            href="/land-national"
                            data-translate="footer_land_national"
                            >Servicio Terrestre Nacional</a
                        >
                    </li>
                    <li class="mb-2">
                        <a
                            class="link"
                            href="/land-international"
                            data-translate="footer_land_international"
                            >Servicio Terrestre Internacional</a
                        >
                    </li>

                    <li class="mb-2">
                        <a
                            class="link"
                            href="/#cotizaciones"
                            data-translate="footer_quote">Cotizaciones</a
                        >
                    </li>
                </ul>
            </div>
            <div class="col-lg-2 col-md-6 mb-4">
                <h5 class="mb-3" data-translate="footer_company">Empresa</h5>
                <ul class="list-unstyled">
                    <li class="mb-2">
                        <a
                            class="link"
                            href="/#nosotros"
                            data-translate="footer_about">Acerca de</a
                        >
                    </li>
                </ul>
            </div>
            <div class="col-lg-2 col-md-6 mb-4">
                <h5 class="mb-3" data-translate="footer_support">Soporte</h5>
                <ul class="list-unstyled">
                    <li class="mb-2">
                        <a
                            class="link"
                            href="/#contacto"
                            data-translate="footer_contact">Contacto</a
                        >
                    </li>
                    <li class="mb-2">
                        <a
                            class="link"
                            href="/privacy"
                            data-translate="footer_privacy">Privacidad</a
                        >
                    </li>
                </ul>
            </div>
        </div>
        <hr class="my-4 bg-secondary" />
        <div class="row">
            <div class="col-md-6 text-center text-md-start">
                <p class="mb-0">
                    &copy; 2026 {company}. <span data-translate="footer_rights"
                        >Todos los derechos reservados</span
                    >.
                </p>
            </div>
            <div class="col-md-6 text-center text-md-end">
                <p class="mb-0">
                    <a
                        class="author"
                        href="https://bycarmona141.github.io/"
                        target="_blank"
                    >
                        <span data-translate="footer_made"
                            >Hecho por ByCarmona141</span
                        >
                        <i class="fa-brands fa-github"></i>
                    </a>
                </p>
            </div>
        </div>
    </div>
</footer>
