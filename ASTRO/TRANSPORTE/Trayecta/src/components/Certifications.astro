                    </p>

                    <div class="cert-info">
                        <div class="cert-info-item">
                            <i class="fas fa-certificate"></i>
                            <p class="m-0">
                                <strong data-translate="cert_iso_cert"
                                    >Certificado:</strong
                                >
                                BCI/GIG190207K5A/120624
                            </p>
                        </div>
                        <div class="cert-info-item">
                            <i class="fas fa-calendar-check"></i>
                            <p class="m-0">
                                <strong data-translate="cert_iso_emission"
                                    >Emisión:</strong
                                >
                                12 de Junio de 2024
                            </p>
                        </div>
                        <div class="cert-info-item">
                            <i class="fas fa-calendar-alt"></i>
                            <p class="m-0">
                                <strong data-translate="cert_iso_validity"
                                    >Vigencia:</strong
                                >
                                11 de Junio de 2028
                            </p>
                        </div>
                        <div class="cert-info-item">
                            <i class="fas fa-building"></i>
                            <p class="m-0">
                                <strong data-translate="cert_iso_awarded_by"
                                    >Otorgado por:</strong
                                >
                                Buró de Certificaciones Internacionales y Sistemas
                                Integrados
                            </p>
                        </div>
                        <div class="cert-info-item">
                            <i class="fas fa-truck"></i>
                            <p class="m-0">
                                <strong data-translate="cert_iso_scope"
                                    >Alcance:</strong
                                >
                                Servicios de transporte de carga terrestre en modalidades
                                de unidad tipo caja seca y plataformas
                            </p>
                        </div>
                    </div>

                    <div class="cert-actions">
                        <a
                            href="/assets/pdf/Certificado-ISO.pdf"
                            target="_blank"
                            class="cert-btn cert-btn-primary"
                        >
                            <i class="fas fa-file-pdf"></i>
                            <span data-translate="cert_iso_view"
                                >Ver Certificado</span
                            >
                        </a>
                    </div>
                </div>
            </div>

            <!-- Certificación C-TPAT -->
            <div class="cert-card">
                <div class="cert-icon">
                    <img src="/ctpat.svg" alt="C-TPAT" />
                </div>
                <div class="cert-content">
                    <h3>C-TPAT</h3>
                    <p class="cert-standard">
                        Customs-Trade Partnership Against Terrorism
                    </p>

                    <div class="cert-info">
                        <div class="cert-info-item">
                            <i class="fas fa-shield-alt"></i>
                            <p class="m-0">
                                <strong data-translate="cert_ctpat_program"
                                    >Programa:</strong
                                >
                                <span data-translate="cert_ctpat_program_name"
                                    >Alianza Aduanera contra el Terrorismo</span
                                >
                            </p>
                        </div>
                        <div class="cert-info-item">
                            <i class="fas fa-globe-americas"></i>
                            <p class="m-0">
                                <strong data-translate="cert_ctpat_issued_by"
                                    >Otorgado por:</strong
                                >
                                <span data-translate="cert_ctpat_issued_by_name"
                                    >U.S. Customs and Border Protection (CBP)</span
                                >
                            </p>
                        </div>
                        <div class="cert-info-item">
                            <i class="fas fa-lock"></i>
                            <p class="m-0">
                                <strong data-translate="cert_ctpat_benefit"
                                    >Beneficio:</strong
                                >
                                <span data-translate="cert_ctpat_benefit_name"
                                    >Procesamiento acelerado en aduanas
                                    estadounidenses</span
                                >
                            </p>
                        </div>
                        <div class="cert-info-item">
                            <i class="fas fa-check-circle"></i>
                            <p class="m-0">
                                <strong data-translate="cert_ctpat_validation"
                                    >Validación:</strong
                                >
                                <span
                                    data-translate="cert_ctpat_validation_name"
                                    >Cumplimiento de estándares internacionales
                                    de seguridad en la cadena de suministro</span
                                >
                            </p>
                        </div>
                    </div>

                    <div class="cert-id">ID: 22796434</div>
                </div>
            </div>
        </div>
    </div>
</section>
