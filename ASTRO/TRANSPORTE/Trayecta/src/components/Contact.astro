<style>
    /* ── Contact Section ── */
    .contact-section {
        padding-bottom: 100px;
        background: white;
    }

    /* Welcome banner */
    .contact-welcome {
        background: linear-gradient(
            135deg,
            var(--primary-color),
            var(--secondary-color)
        );
        border-radius: 20px;
        padding: 50px 60px;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 30px;
        margin-bottom: 60px;
        position: relative;
        overflow: hidden;
    }

    .contact-welcome::before {
        content: "";
        position: absolute;
        top: -60px;
        right: -60px;
        width: 250px;
        height: 250px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.06);
        pointer-events: none;
    }

    .contact-welcome::after {
        content: "";
        position: absolute;
        bottom: -80px;
        right: 120px;
        width: 180px;
        height: 180px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.04);
        pointer-events: none;
    }

    .contact-welcome-text h3 {
        text-align: center;
        font-size: 1.9rem;
        font-weight: 700;
        margin-bottom: 10px;
    }

    .contact-welcome-text p {
        font-size: 1.05rem;
        opacity: 0.85;
        margin: 0;
        line-height: 1.7;
    }

    @keyframes blink {
        0%,
        100% {
            opacity: 1;
        }
        50% {
            opacity: 0.3;
        }
    }

    /* Contact channel cards */
    .channel-card {
        background: #f8f9fa;
        border: 2px solid transparent;
        border-radius: 18px;
        padding: 30px 25px;
        text-align: center;
        text-decoration: none;
        color: inherit;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 12px;
        transition: all 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
        height: 100%;
    }

    .channel-card:hover {
        background: white;
        border-color: var(--primary-color);
        box-shadow: 0 12px 40px rgba(10, 62, 142, 0.15);
        transform: translateY(-8px);
        color: inherit;
    }

    .channel-icon {
        width: 64px;
        height: 64px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.7rem;
        color: white;
        transition: all 0.3s;
    }

    .channel-card:hover .channel-icon {
        transform: scale(1.1);
    }

    .icon-whatsapp {
        background: linear-gradient(135deg, #25d366, #128c7e);
    }
    .icon-email {
        background: linear-gradient(
            135deg,
            var(--primary-color),
            var(--secondary-color)
        );
    }

    .channel-label {
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #999;
    }

    .channel-title {
        font-size: 1rem;
        font-weight: 700;
        color: var(--secondary-color);
        margin: 0;
    }

    .channel-detail {
        font-size: 0.85rem;
        color: #777;
        margin: 0;
    }

    /* Info bottom row */
    .info-card {
        background: #f8f9fa;
        border-radius: 18px;
        padding: 35px 30px;
        height: 100%;
        transition: all 0.3s;
        border: 2px solid transparent;
    }

    .info-card:hover {
        border-color: var(--primary-color);
        background: white;
        box-shadow: 0 10px 35px rgba(10, 62, 142, 0.1);
    }

    .info-card-icon {
        width: 52px;
        height: 52px;
        background: linear-gradient(
            135deg,
            var(--primary-color),
            var(--secondary-color)
        );
        border-radius: 13px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 1.3rem;
        margin-bottom: 18px;
    }

    .info-card h5 {
        font-size: 1rem;
        font-weight: 700;
        color: var(--secondary-color);
        margin-bottom: 10px;
    }

    .info-card p,
    .info-card address {
        font-size: 0.9rem;
        color: #666;
        line-height: 1.8;
        margin: 0;
        font-style: normal;
    }

    .schedule-row {
        display: flex;
        justify-content: space-between;
        font-size: 0.88rem;
        padding: 6px 0;
        border-bottom: 1px solid #f0f0f0;
        color: #555;
    }

    .schedule-row:last-child {
        border-bottom: none;
    }

    .schedule-row .day {
        font-weight: 600;
        color: var(--secondary-color);
    }

    .schedule-open {
        background: #ecfdf5;
        color: #16a34a;
        font-size: 0.7rem;
        font-weight: 700;
        padding: 2px 8px;
        border-radius: 20px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .schedule-close {
        background: #fdecec;
        color: #a00b0b;
        font-size: 0.7rem;
        font-weight: 700;
        padding: 2px 8px;
        border-radius: 20px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .channel-card-lg {
        padding: 45px 35px;
        gap: 14px;
    }

    .channel-icon-lg {
        width: 90px;
        height: 90px;
        border-radius: 22px;
        font-size: 2.4rem;
    }

    .channel-title-lg {
        font-size: 1.4rem !important;
    }

    .channel-cta {
        margin-top: 8px;
        font-size: 0.88rem;
        font-weight: 700;
        color: var(--primary-color);
        letter-spacing: 0.3px;
        opacity: 0;
        transform: translateY(6px);
        transition: all 0.3s ease;
    }

    .channel-card:hover .channel-cta {
        opacity: 1;
        transform: translateY(0);
    }

    .btn-whatsapp-cta .channel-cta {
        color: #128c7e;
    }

    /* Map container */
    .map-wrapper {
        border-radius: 18px;
        overflow: hidden;
        height: 100%;
        min-height: 240px;
        border: 2px solid #e5e5e5;
        transition: border-color 0.3s;
    }

    .map-wrapper:hover {
        border-color: var(--primary-color);
    }

    .map-wrapper iframe {
        width: 100%;
        height: 100%;
        min-height: 240px;
        display: block;
        border: none;
    }

    /* Animations */
    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(24px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .animate-in {
        animation: fadeInUp 0.55s ease both;
    }

    .animate-in:nth-child(1) {
        animation-delay: 0.05s;
    }
    .animate-in:nth-child(2) {
        animation-delay: 0.12s;
    }
    .animate-in:nth-child(3) {
        animation-delay: 0.19s;
    }
    .animate-in:nth-child(4) {
        animation-delay: 0.26s;
    }
    .animate-in:nth-child(5) {
        animation-delay: 0.33s;
    }

    @media (max-width: 768px) {
        .contact-welcome {
            flex-direction: column;
            padding: 35px 28px;
            text-align: center;
        }
        .contact-welcome-text p {
            max-width: 100%;
        }
    }
</style>

<section class="contact-section" id="contacto">
    <div class="container">
        <!-- Section Header -->
        <div class="text-center mb-5">
            <h2 class="section-title" data-translate="contact_title">
                Contáctanos
            </h2>
            <p class="section-subtitle">
                Estamos disponibles para atenderte por el canal que prefieras
            </p>
        </div>

        <!-- Welcome Banner -->
        <div class="contact-welcome animate-in">
            <div class="contact-welcome-text">
                <h3 data-translate="contact_welcome_title">
                    ¿Tienes alguna pregunta o necesitas una cotización?
                </h3>
                <p data-translate="contact_welcome_desc">
                    Nuestro equipo de expertos está listo para asesorarte.
                    Contáctanos por el canal que más te convenga y te
                    responderemos a la brevedad.
                </p>
            </div>
        </div>

        <!-- Channel Cards -->
        <div class="row g-4 mb-4 justify-content-center">
            <!-- WhatsApp -->
            <div class="col-lg-5 col-md-6 animate-in">
                <a
                    href="https://wa.me/2223716661?text=Hola%2C%20me%20gustar%C3%ADa%20recibir%20m%C3%A1s%20informaci%C3%B3n%20sobre%20sus%20servicios."
                    target="_blank"
                    class="channel-card channel-card-lg"
                >
                    <div class="channel-icon icon-whatsapp channel-icon-lg">
                        <i class="fa-brands fa-whatsapp"></i>
                    </div>
                    <span
                        class="channel-label"
                        data-translate="contact_whatsapp_label"
                        >Respuesta inmediata</span
                    >
                    <p class="channel-title channel-title-lg">WhatsApp</p>
                    <p class="channel-detail">+52 222 371 6661</p>
                    <span
                        class="channel-cta"
                        data-translate="contact_whatsapp_cta"
                        >Enviar mensaje →</span
                    >
                </a>
            </div>

            <!-- Email -->
            <div class="col-lg-5 col-md-6 animate-in">
                <a
                    href="mailto:ventas1@igsforwarding.com.mx?subject=Solicitud%20de%20informaci%C3%B3n"
                    class="channel-card channel-card-lg"
                >
                    <div class="channel-icon icon-email channel-icon-lg">
                        <i class="fas fa-envelope"></i>
                    </div>
                    <span
                        class="channel-label"
                        data-translate="contact_email_label"
                        >Cotización detallada</span
                    >
                    <p class="channel-title channel-title-lg">
                        Correo Electrónico
                    </p>
                    <p class="channel-detail">ventas1@igsforwarding.com.mx</p>
                    <span class="channel-cta" data-translate="contact_email_cta"
                        >Enviar correo →</span
                    >
                </a>
            </div>
        </div>

        <!-- Bottom Row: Address + Schedule + Map -->
        <div class="row g-4">
            <!-- Dirección -->
            <div class="col-lg-3 col-md-6">
                <div class="info-card h-100">
                    <div class="info-card-icon">
                        <i class="fas fa-map-marker-alt"></i>
                    </div>
                    <h5 data-translate="contact_address_title">Dirección</h5>
                    <address>
                        Cda. Popocatépetl No. 6<br />
                        Entre Citlali y Tlaloc<br />
                        Col. Heritage I Conjunto Habitacional<br />
                        C.P. 72575<br />
                        Puebla, Puebla, México
                    </address>
                </div>
            </div>

            <!-- Horarios -->
            <div class="col-lg-3 col-md-6">
                <div class="info-card h-100">
                    <div class="info-card-icon">
                        <i class="fas fa-clock"></i>
                    </div>
                    <h5 data-translate="contact_schedule_title">
                        Horario de atención
                    </h5>
                    <div class="schedule-row">
                        <span class="day" data-translate="contact_weekdays"
                            >Lun – Vie</span
                        >
                        <span
                            >9:00 – 18:00 <span
                                class="schedule-open"
                                data-translate="contact_open">Abierto</span
                            ></span
                        >
                    </div>
                    <div class="schedule-row">
                        <span class="day" data-translate="contact_saturday"
                            >Sábado</span
                        >
                        <span
                            >9:00 – 14:00 <span
                                class="schedule-open"
                                data-translate="contact_open">Abierto</span
                            ></span
                        >
                    </div>
                    <div class="schedule-row">
                        <span class="day" data-translate="contact_sunday"
                            >Domingo</span
                        >
                        <span
                            class="schedule-close"
                            data-translate="contact_closed">Cerrado</span
                        >
                    </div>
                    <p
                        class="mt-3"
                        style="font-size:0.82rem; color:#999;"
                        data-translate="contact_schedule_note"
                    >
                        * WhatsApp disponible fuera de horario
                    </p>
                </div>
            </div>

            <!-- Mapa -->
            <div class="col-lg-6">
                <div class="map-wrapper">
                    <iframe
                        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3772.123!2d-98.2430!3d19.0413!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zMTnCsDAyJzI4LjciTiA5OMKwMTQnMzQuOCJX!5e0!3m2!1ses!2smx!4v1700000000000"
                        allowfullscreen=""
                        loading="lazy"
                        referrerpolicy="no-referrer-when-downgrade"
                        title="Ubicación IGS Forwarding"></iframe>
                </div>
            </div>
        </div>
    </div>
</section>
