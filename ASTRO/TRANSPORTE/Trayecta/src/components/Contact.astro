<style>
    /* ── Contact Section ── */
    .contact-section {
        padding-bottom: 100px;
        background: white;
    }

    /* Welcome banner */
    .contact-welcome {
        background: linear-gradient(
            135deg,
            var(--primary-color),
            var(--secondary-color)
        );
        border-radius: 20px;
        padding: 50px 60px;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 30px;
        margin-bottom: 60px;
        position: relative;
        overflow: hidden;
    }

    .contact-welcome::before {
        content: "";
        position: absolute;
        top: -60px;
        right: -60px;
        width: 250px;
        height: 250px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.06);
        pointer-events: none;
    }

    .contact-welcome::after {
        content: "";
        position: absolute;
        bottom: -80px;
        right: 120px;
        width: 180px;
        height: 180px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.04);
        pointer-events: none;
    }

    .contact-welcome-text h3 {
        text-align: center;
        font-size: 1.9rem;
        font-weight: 700;
        margin-bottom: 10px;
    }

    .contact-welcome-text p {
        font-size: 1.05rem;
        opacity: 0.85;
        margin: 0;
        line-height: 1.7;
    }

    @keyframes blink {
        0%,
        100% {
            opacity: 1;
        }
        50% {
            opacity: 0.3;
        }
    }

    /* Contact channel cards */
    .channel-card {
        background: #f8f9fa;
        border: 2px solid transparent;
        border-radius: 18px;
        padding: 30px 25px;
        text-align: center;
        text-decoration: none;
        color: inherit;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 12px;
        transition: all 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
        height: 100%;
    }

    .channel-card:hover {
        background: white;
        border-color: var(--primary-color);
        box-shadow: 0 12px 40px rgba(10, 62, 142, 0.15);
        transform: translateY(-8px);
        color: inherit;
    }

    .channel-icon {
        width: 64px;
        height: 64px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.7rem;
        color: white;
        transition: all 0.3s;
    }

    .channel-card:hover .channel-icon {
        transform: scale(1.1);
    }

    .icon-whatsapp {
        background: linear-gradient(135deg, #25d366, #128c7e);
    }
    .icon-email {
        background: linear-gradient(
            135deg,
            var(--primary-color),
            var(--secondary-color)
        );
    }

    .channel-label {
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #999;
    }

    .channel-title {
        font-size: 1rem;
        font-weight: 700;
        color: var(--secondary-color);
        margin: 0;
    }

    .channel-detail {
        font-size: 0.85rem;
        color: #777;
        margin: 0;
    }

    .channel-card-lg {
        padding: 45px 35px;
        gap: 14px;
    }

    .channel-icon-lg {
        width: 90px;
        height: 90px;
        border-radius: 22px;
        font-size: 2.4rem;
    }

    .channel-title-lg {
        font-size: 1.4rem !important;
    }

    .channel-cta {
        margin-top: 8px;
        font-size: 0.88rem;
        font-weight: 700;
        color: var(--primary-color);
        letter-spacing: 0.3px;
        opacity: 0;
        transform: translateY(6px);
        transition: all 0.3s ease;
    }

    .channel-card:hover .channel-cta {
        opacity: 1;
        transform: translateY(0);
    }

    .btn-whatsapp-cta .channel-cta {
        color: #128c7e;
    }

    /* Map container */
    .map-wrapper {
        border-radius: 18px;
        overflow: hidden;
        height: 100%;
        min-height: 240px;
        border: 2px solid #e5e5e5;
        transition: border-color 0.3s;
    }

    .map-wrapper:hover {
        border-color: var(--primary-color);
    }

    .map-wrapper iframe {
        width: 100%;
        height: 100%;
        min-height: 240px;
        display: block;
        border: none;
    }

    /* Animations */
    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(24px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .animate-in {
        animation: fadeInUp 0.55s ease both;
    }

    .animate-in:nth-child(1) {
        animation-delay: 0.05s;
    }
    .animate-in:nth-child(2) {
        animation-delay: 0.12s;
    }
    .animate-in:nth-child(3) {
        animation-delay: 0.19s;
    }
    .animate-in:nth-child(4) {
        animation-delay: 0.26s;
    }
    .animate-in:nth-child(5) {
        animation-delay: 0.33s;
    }

    @media (max-width: 768px) {
        .contact-welcome {
            flex-direction: column;
            padding: 35px 28px;
            text-align: center;
        }
        .contact-welcome-text p {
            max-width: 100%;
        }
    }
</style>

<section class="contact-section" id="contacto">
    <div class="container">
        <!-- Section Header -->
        <div class="text-center mb-5">
            <h2 class="section-title" data-translate="contact_title">
                Contáctanos
            </h2>
            <p class="section-subtitle">
                Estamos disponibles para atenderte por el canal que prefieras
            </p>
        </div>

        <!-- Welcome Banner -->
        <div class="contact-welcome animate-in">
            <div class="contact-welcome-text">
                <h3 data-translate="contact_welcome_title">
                    ¿Tienes alguna pregunta o necesitas una cotización?
                </h3>
                <p data-translate="contact_welcome_desc">
                    Nuestro equipo de expertos está listo para asesorarte.
                    Contáctanos por el canal que más te convenga y te
                    responderemos a la brevedad.
                </p>
            </div>
        </div>

        <!-- Channel Cards -->
        <div class="row g-4 mb-4 justify-content-center">
            <!-- WhatsApp -->
            <div class="col-lg-5 col-md-6 animate-in">
                <a
                    href="https://wa.me/2225548104?text=Hola%2C%20me%20gustar%C3%ADa%20recibir%20m%C3%A1s%20informaci%C3%B3n%20sobre%20sus%20servicios."
                    target="_blank"
                    class="channel-card channel-card-lg"
                >
                    <div class="channel-icon icon-whatsapp channel-icon-lg">
                        <i class="fa-brands fa-whatsapp"></i>
                    </div>
                    <span
                        class="channel-label"
                        data-translate="contact_whatsapp_label"
                        >Respuesta inmediata</span
                    >
                    <p class="channel-title channel-title-lg">WhatsApp</p>
                    <p class="channel-detail">+52 222 554 8104</p>
                    <span
                        class="channel-cta"
                        data-translate="contact_whatsapp_cta"
                        >Enviar mensaje →</span
                    >
                </a>
            </div>

            <!-- Mapa -->
            <div class="col-lg-5 col-md-6 animate-in">
                <div class="map-wrapper">
                    <iframe
                        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3772.123!2d-98.2430!3d19.0413!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zMTnCsDAyJzI4LjciTiA5OMKwMTQnMzQuOCJX!5e0!3m2!1ses!2smx!4v1700000000000"
                        allowfullscreen=""
                        loading="lazy"
                        referrerpolicy="no-referrer-when-downgrade"
                        title="Ubicación IGS Forwarding"></iframe>
                </div>
            </div>
        </div>
    </div>
</section>
