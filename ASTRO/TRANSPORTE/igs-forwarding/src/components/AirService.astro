                                >
                            </li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Despacho aduanal -->
            <div class="service-modality pb-0">
                <div class="row align-items-center">
                    <div class="col-lg-3 mb-4 mb-lg-0">
                        <div class="modality-icon-box">
                            <i class="fas fa-file-invoice"></i>
                        </div>
                    </div>
                    <div class="col-lg-9">
                        <div
                            class="modality-badge"
                            data-translate="air_clearance_badge"
                        >
                            Despacho aduanal
                        </div>
                        <h3
                            class="modality-title"
                            data-translate="air_clearance_title"
                        >
                            Despacho aduanal
                        </h3>
                        <!-- <p class="modality-desc" data-translate="dgr_desc">
                            Transporte marítimo de maquinaria, estructuras y piezas que exceden las dimensiones estándar de un contenedor.
                        </p> -->
                        <ul class="modality-features">
                            <li>
                                <i class="fas fa-check-circle"></i>
                                <span data-translate="air_clearance_feat1"
                                    >Coordinación con agentes aduanales en
                                    origen y destino</span
                                >
                            </li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- DAP / DDP -->
            <div class="service-modality pb-0">
                <div class="row align-items-center">
                    <div class="col-lg-3 order-lg-2 mb-4 mb-lg-0">
                        <div class="modality-icon-box">
                            <i class="fa-solid fa-box-open"></i>
                        </div>
                    </div>
                    <div class="col-lg-9 order-lg-1">
                        <div
                            class="modality-badge"
                            data-translate="air_dd_badge"
                        >
                            DAP / DDP
                        </div>
                        <h3
                            class="modality-title"
                            data-translate="air_dd_title"
                        >
                            Revalidaciones y servicios DAP / DDP
                        </h3>
                        <!-- <p class="modality-desc" data-translate="dd_desc">
                            Perfecto para cargas exclusivas o de gran volumen.
                        </p> -->
                        <ul class="modality-features">
                            <li>
                                <i class="fas fa-check-circle"></i>
                                <span data-translate="air_dd_feat1"
                                    >Revalidaciones en destino con agentes
                                    designados y en México</span
                                >
                            </li>
                            <li>
                                <i class="fas fa-check-circle"></i>
                                <span data-translate="air_dd_feat2"
                                    >Manejo de entregas bajo términos DAP
                                    (Delivered at Place) y DDP (Delivered Duty
                                    Paid)</span
                                >
                            </li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- DGR -->
            <div class="service-modality pb-0">
                <div class="row align-items-center">
                    <div class="col-lg-3 mb-4 mb-lg-0">
                        <div class="modality-icon-box">
                            <i class="fa-solid fa-triangle-exclamation"></i>
                        </div>
                    </div>
                    <div class="col-lg-9">
                        <div
                            class="modality-badge"
                            data-translate="air_dgr_badge"
                        >
                            DGR
                        </div>
                        <h3
                            class="modality-title"
                            data-translate="air_dgr_title"
