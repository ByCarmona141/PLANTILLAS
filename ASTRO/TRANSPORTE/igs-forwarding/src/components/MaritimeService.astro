                                    >Equipos y personal certificado</span
                                >
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Soporte Logístico -->
    <section class="service-section bg-light">
        <div class="container">
            <div class="text-center mb-5">
                <h2
                    class="section-title"
                    data-translate="maritime_support_title"
                >
                    Soporte Logístico Integral
                </h2>
            </div>
