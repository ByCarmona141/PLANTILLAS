<style>
    /* Hero Section - INICIO */
    .hero-section {
        background: linear-gradient(
            135deg,
            var(--secondary-color) 0%,
            var(--secondary-color) 100%
        );
        color: white;
        padding: 60px 0;
        position: relative;
        overflow: hidden;
        height: 50vh;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-top: -70px;
        padding-top: 130px;
    }

    .hero-main-content {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .full-width-half-height {
        height: 50vh;
        width: 100vw;
    }

    .full-width-half-height .carousel-inner {
        height: 100%;
    }

    .full-width-half-height .carousel-item {
        height: 100%;
    }

    .full-width-half-height .carousel-item img {
        height: 100%;
        object-fit: cover;
    }

    .carousel-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .carousel-item {
        position: relative;
        overflow: hidden;
    }

    .carousel-item::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: linear-gradient(
            135deg,
            var(--bg-primary-color-hover),
            var(--bg-secondary-color-hover)
        );
        z-index: 1;
    }

    .carousel-caption {
        z-index: 2;
    }

    .carousel-title {
        font-size: 3.5rem;
        font-weight: 700;
        margin-bottom: 20px;
        animation: fadeInUp 0.8s ease;
    }

    .carousel-subtitle {
        text-align: center;
        font-size: 1.4rem;
        margin-bottom: 30px;
        opacity: 0.95;
        animation: fadeInUp 1s ease;
    }
    /* Service Page Styles */

    /* Navbar Active State Override */
    .navbar .nav-link {
        color: var(--light-color) !important;
    }

    .navbar .nav-link:hover {
        color: var(--tertiary-color) !important;
    }

    .navbar .nav-link.active {
        color: var(--primary-color) !important;
    }

    .navbar .nav-link::after {
        background: var(--tertiary-color);
    }

    .bg-dark {
        background-color: var(--dark-color) !important;
    }

    /* Hero Section */
    .service-hero {
        padding: 180px 0 120px;
        color: white;
        position: relative;
        background: linear-gradient(
                135deg,
                rgba(0, 102, 204, 0.9),
                rgba(0, 0, 0, 0.8)
            ),
            url("../assets/image/maritime/img1.jpg");
        background-size: cover;
        background-position: center;
    }

    .service-hero::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: linear-gradient(
            135deg,
            rgba(168, 11, 36, 0.85),
            rgba(0, 0, 0, 0.85)
        );
        z-index: 1;
    }

    .service-hero .container {
        position: relative;
        z-index: 2;
    }

    .service-hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        background: rgba(255, 255, 255, 0.2);
        backdrop-filter: blur(10px);
        padding: 12px 24px;
        border-radius: 50px;
        margin-bottom: 20px;
        font-weight: 600;
        animation: fadeInUp 0.6s ease;
    }

    .service-hero-badge i {
        font-size: 1.5rem;
    }

    .service-hero-title {
        font-size: 3.5rem;
        font-weight: 700;
        margin-bottom: 25px;
        animation: fadeInUp 0.8s ease;
    }

    .service-hero-subtitle {
        font-size: 1.3rem;
        line-height: 1.8;
        margin-bottom: 30px;
        opacity: 0.95;
        animation: fadeInUp 1s ease;
    }

    /* Service Section */
    .service-section {
        padding: 80px 0;
    }

    /* Port Cards */
    .port-card {
        background: white;
        padding: 40px;
        border-radius: 20px;
        text-align: center;
        transition: all 0.3s;
        height: 100%;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
    }

    .port-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 15px 40px rgba(0, 0, 0, 0.15);
    }

    .port-icon {
        width: 80px;
        height: 80px;
        background: linear-gradient(
            135deg,
            var(--primary-color),
            var(--secondary-color)
        );
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 20px;
        color: white;
        font-size: 2rem;
    }

    .port-card h4 {
        margin-bottom: 10px;
        color: var(--dark-color);
    }

    /* Coverage Cards */
    .coverage-card {
        background: linear-gradient(
            135deg,
            var(--primary-color),
            var(--secondary-color)
        );
        color: white;
        padding: 50px 30px;
        border-radius: 20px;
        text-align: center;
        transition: all 0.3s;
        height: 100%;
    }

    .coverage-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.2);
    }

    .coverage-number {
        font-size: 4rem;
        font-weight: 700;
        margin-bottom: 20px;
        opacity: 0.95;
    }

    .coverage-card h4 {
        font-size: 1.5rem;
        margin-bottom: 15px;
    }

    .coverage-card p {
        opacity: 0.9;
        line-height: 1.6;
    }

    /* Service Modality */
    .service-modality {
        padding: 60px 0;
    }

    .modality-icon-box {
        background: linear-gradient(
            135deg,
            var(--primary-color),
            var(--secondary-color)
        );
        border-radius: 30px;
        padding: 80px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 6rem;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.15);
    }

    .modality-badge {
        display: inline-block;
        background: var(--primary-color);
        color: white;
        padding: 8px 20px;
        border-radius: 50px;
        font-size: 0.9rem;
        font-weight: 600;
        margin-bottom: 15px;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .modality-title {
        font-size: 2.5rem;
        font-weight: 700;
        margin-bottom: 20px;
        color: var(--dark-color);
    }

    .modality-desc {
        font-size: 1.2rem;
        color: #666;
        margin-bottom: 30px;
    }

    .modality-features {
        list-style: none;
        padding: 0;
        margin-bottom: 20px;
    }

    .modality-features li {
        padding: 15px 0;
        border-bottom: 1px solid #e0e0e0;
        display: flex;
        align-items: center;
        font-size: 1.05rem;
    }

    .modality-features li:last-child {
        border-bottom: none;
    }

    .modality-features i {
        color: var(--primary-color);
        font-size: 1.3rem;
        margin-right: 15px;
        min-width: 30px;
    }

    .sub-features {
        list-style: none;
        padding-left: 20px;
    }

    .sub-features li {
        padding: 10px 0;
        color: #666;
    }

    /* Support Cards */
    .support-card {
        border: 2px solid var(--primary-color);
        background: white;
        padding: 40px 30px;
        border-radius: 20px;
        text-align: center;
        transition: all 0.3s;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
        height: 100%;
    }

    .support-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 15px 40px rgba(0, 0, 0, 0.15);
        background: var(--primary-color);
        color: white;
    }

    .support-card i {
        font-size: 3rem;
        color: var(--primary-color);
        margin-bottom: 20px;
        transition: all 0.3s;
    }

    .support-card:hover i {
        color: white;
    }

    .support-card h5 {
        font-size: 1.1rem;
        font-weight: 600;
    }

    /* Customs Clearance Cards */
    .custom-clearance-card {
        border: 2px solid var(--primary-color);
        background: white;
        padding: 40px 30px;
        border-radius: 20px;
        text-align: center;
        transition: all 0.3s;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
        height: 100%;
    }

    .custom-clearance-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 15px 40px rgba(0, 0, 0, 0.15);
        background: var(--primary-color);
        color: white;
    }

    .custom-clearance-card i {
        font-size: 3rem;
        color: var(--primary-color);
        margin-bottom: 20px;
        transition: all 0.3s;
    }

    .custom-clearance-card:hover i {
        color: white;
    }

    .custom-clearance-card h5 {
        font-size: 1.1rem;
        font-weight: 600;
    }

    /* Advantage Cards */
    .advantage-card {
        background: var(--bg-tertiary-color);
        backdrop-filter: blur(10px);
        padding: 40px 30px;
        border-radius: 20px;
        text-align: center;
        transition: all 0.3s;
        border: 2px solid rgba(255, 255, 255, 0.2);
    }

    .advantage-card:hover {
        background: var(--primary-color);
        transform: translateY(-10px);
    }

    .advantage-card:hover i,
    .advantage-card:hover h5 {
        color: var(--bg-tertiary-color);
    }

    .advantage-card i {
        font-size: 3rem;
        margin-bottom: 20px;
        color: var(--secondary-color);
    }

    .advantage-card h5 {
        font-size: 1.1rem;
        font-weight: 600;
        color: var(--secondary-color);
    }

    /* CTA Section */
    .cta-section {
        padding: 100px 0;
        background: linear-gradient(
            135deg,
            var(--primary-color),
            var(--secondary-color)
        );
        color: white;
    }

    .cta-section h2 {
        font-size: 3rem;
        font-weight: 700;
    }

    .cta-section .lead {
        font-size: 1.3rem;
        opacity: 0.95;
    }

    /* Responsive */
    @media (max-width: 768px) {
        .service-hero {
            padding: 140px 0 80px;
        }

        .service-hero-title {
            font-size: 2.2rem;
        }

        .service-hero-subtitle {
            font-size: 1.1rem;
        }

        .modality-icon-box {
            padding: 60px;
            font-size: 4rem;
        }

        .modality-title {
            font-size: 1.8rem;
        }

        .coverage-number {
            font-size: 3rem;
        }

        .cta-section h2 {
            font-size: 2rem;
        }
    }
</style>

<section id="servicios">
